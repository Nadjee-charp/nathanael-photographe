# ============================================================
#  nathanaelcharpentier.com — configuration Apache (OVH)
#  À déposer à la racine de l'hébergement, avec le contenu de dist/.
#
#  Rôle principal : conserver le référencement de l'ancien site WordPress.
#  Chaque adresse connue de Google depuis 2019 doit atterrir sur la page
#  équivalente du nouveau site, sinon l'autorité accumulée se perd en 404.
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ——— 1. Une seule adresse canonique : https, sans www ———
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sur l'hébergement mutualisé OVH, c'est le port qui dit si la visite arrive en http
  # (règle recommandée par OVH ; %{HTTPS} n'y est pas toujours fiable).
  RewriteCond %{SERVER_PORT} ^80$
  RewriteRule ^(.*)$ https://nathanaelcharpentier.com/$1 [R=301,L]

  # Une seule adresse : www, l'adresse technique du cluster OVH ou tout autre domaine
  # rattaché à l'hébergement arrivent sur nathanaelcharpentier.com.
  RewriteCond %{HTTP_HOST} !^nathanaelcharpentier\.com$ [NC]
  RewriteRule ^(.*)$ https://nathanaelcharpentier.com/$1 [R=301,L]
</IfModule>

# ——— 2. Redirections depuis l'ancien site WordPress ———
# Les pages qui avaient un vrai contenu, vers leur équivalent.
Redirect 301 /about/                    /a-propos/
Redirect 301 /contact-2/                /contact/
Redirect 301 /devis-en-ligne/           /contact/
Redirect 301 /reseaux/                  /contact/
Redirect 301 /pricing/                  /mariage/
Redirect 301 /conditions-generales/     /mentions-legales/
Redirect 301 /famille                   /portrait/
Redirect 301 /autres                    /portrait/
Redirect 301 /shooting/                 /portrait/
Redirect 301 /accouchement/             /a-propos/

# Les reportages du portfolio, vers la page territoire correspondante.
Redirect 301 /portfolio/mariage-a-deauville-de-marine-hugo/            /photographe-mariage-normandie/
Redirect 301 /portfolio/mariage-en-andalousie-annikadidier/            /mariage-destination/
Redirect 301 /portfolio/mariage-virginieboubou-domaine-de-murtoli-corse/ /photographe-mariage-corse/
Redirect 301 /portfolio/mariage-intimiste-dopheliechristophe/          /mariage/
Redirect 301 /portfolio/mariage-retrospective/                         /mariage/
Redirect 301 /portfolio/photo-journalisme/                             /mariage/
Redirect 301 /portfolio/musique-concert/                               /portrait/
Redirect 301 /portfolio/corporate/                                     /portrait/
Redirect 301 /portfolio/portraits-mode/                                /portrait/
Redirect 301 /portfolio/reportage-accouchement/                        /a-propos/
Redirect 301 /portfolio/grossesse-bebe/                                /a-propos/
Redirect 301 /portfolio/reportages-grossesse-bebe-lifestyle/           /a-propos/
Redirect 301 /portfolio/photos-pour-page-daccueil/                     /
Redirect 301 /portfolio/                                               /mariage/

# L'unique article du blog.
RedirectMatch 301 ^/prime-parmi-les-meilleurs-de-region-centre.*$       /a-propos/

<IfModule mod_rewrite.c>
  # La catégorie de portfolio mariage avait du contenu : elle passe avant la règle
  # « portfolio- » ci-dessous, qui l'enverrait sinon en 410.
  RewriteRule ^portfolio-category/mariage/?$ https://nathanaelcharpentier.com/mariage/ [R=301,L]

  # Les pages de démonstration du thème et la boutique n'ont jamais eu de contenu :
  # 410 plutôt que 301, pour que Google les retire au lieu de les suivre.
  RewriteRule ^(shop|shop-2|cart|checkout|my-account|my-account-2)/?$ - [G,L]
  RewriteRule ^(masonry-|portfolio-|original-ratio|fullscreen-|carousel-|interactive-|before-after|test-|testimonials) - [G,L]

  # Les traces de WordPress : rien à servir, et autant couper court aux robots.
  RewriteRule ^(wp-admin|wp-login|wp-json|wp-includes|xmlrpc) - [G,L]
  RewriteRule ^(feed|comments/feed)/?$ - [G,L]
</IfModule>

# Tout le reste du domaine qui n'existe plus arrive sur la page 404 du site.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ——— 3. Compression ———
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ——— 4. Cache ———
# Les images et les polices portent une empreinte dans leur nom : elles peuvent
# être gardées un an. Le HTML, lui, doit rester frais.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# ——— 5. En-têtes de sécurité ———
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
