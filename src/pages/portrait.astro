---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Galerie from '../components/Galerie.astro';
import Faq from '../components/Faq.astro';
import Invitation from '../components/Invitation.astro';
import { img, alt, galerie } from '../lib/photos';

const hero = 'portrait-art-ame-main-visage-noir-et-blanc-nathanael-charpentier.jpg';

// [I-04] Page Portrait — sélection dans Photos site/Portrait
const photos = galerie([
  'portrait-art-ame-pensive-fond-peint-nathanael-charpentier.jpg',
  'portrait-art-ame-lumiere-laterale-studio-gien-nathanael-charpentier.jpg',
  'portrait-art-ame-larme-essuyee-nathanael-charpentier.jpg',
  'portrait-art-ame-regard-leve-noir-et-blanc-nathanael-charpentier.jpg',
  'portrait-art-ame-silhouette-fenetre-lampe-nathanael-charpentier.jpg',
  'portrait-art-ame-miroir-rond-nathanael-charpentier.jpg',
  'portrait-art-ame-sourire-fond-peint-nathanael-charpentier.jpg',
  'detail-main-bracelets-portrait-art-ame-nathanael-charpentier.jpg',
  'portrait-cheveux-regard-baisse-noir-et-blanc-nathanael-charpentier.jpg',
  'portrait-main-pudeur-noir-et-blanc-nathanael-charpentier.jpg',
  'portrait-profil-penombre-nathanael-charpentier.jpg',
  'portrait-justine-bourrelier-drape-ivoire-studio-gien-nathanael-charpentier.jpg',
  'portrait-justine-bourrelier-mains-visage-studio-gien-nathanael-charpentier.jpg',
  'portrait-justine-bourrelier-costume-sombre-studio-gien-nathanael-charpentier.jpg',
  'portrait-robe-noire-salon-chateau-de-villette-nathanael-charpentier.jpg',
  'portrait-robe-bleue-satin-studio-gien-nathanael-charpentier.jpg',
  'robe-blanche-mouvement-escalier-noir-et-blanc-nathanael-charpentier.jpg',
  'portrait-maelle-menotti-sequins-lumiere-fenetre-nathanael-charpentier.jpg',
  'portrait-maelle-menotti-art-ame-chesterfield-nathanael-charpentier.jpg',
  'portrait-rire-chesterfield-mur-vert-nathanael-charpentier.jpg',
  'portrait-homme-lin-drape-clair-nathanael-charpentier.jpg',
  'portrait-homme-chapeau-melon-studio-gien-nathanael-charpentier.jpg',
  'portrait-homme-exterieur-brique-portail-nathanael-charpentier.jpg',
  'portrait-noir-et-blanc-ombre-mur-studio-gien-nathanael-charpentier.jpg',
  'portrait-noir-et-blanc-regard-epaule-marseille-nathanael-charpentier.jpg',
  'portrait-tabouret-fond-clair-studio-gien-nathanael-charpentier.jpg',
  'detail-mains-croisees-noir-et-blanc-nathanael-charpentier.jpg',
  'detail-main-penombre-portrait-nathanael-charpentier.jpg',
  'portrait-adolescent-piano-noir-et-blanc-nathanael-charpentier.jpg',
  'musicien-archet-cercle-lumiere-nathanael-charpentier.jpg',
]);

// [M-11bis] FAQ — « réponse d'abord », montants uniquement ici, jamais en façade
const faq = [
  {
    q: 'Que comprend une séance Portrait: Art & Âme ?',
    r: 'Une séance Portrait: Art & Âme avec Nathanaël Charpentier comprend un rendez-vous de préparation (au studio, en visio ou par téléphone), la construction d’un moodboard, une journée de prise de vue, le maquillage si vous le souhaitez, le repas, l’ensemble des fichiers retouchés, cinq tirages fine art 20×30 signés, un agrandissement A3+ sur papier fine art encadré et signé, ainsi qu’un diaporama de la séance mis en musique. À partir de 1 200 €.',
  },
  {
    q: 'Les fichiers numériques sont-ils inclus ?',
    r: 'Oui. Tous les fichiers retouchés de la séance vous sont remis, sans supplément et sans sélection imposée. Ils vous appartiennent. Les tirages fine art signés et l’agrandissement encadré sont compris en plus, dans le même tarif.',
  },
  {
    q: 'Combien coûte un portrait avec Nathanaël Charpentier ?',
    r: 'Une séance Portrait: Art & Âme avec Nathanaël Charpentier commence à 1 200 €, et à 1 950 € pour la version accompagnée d’une œuvre dessinée à la main. Le tarif comprend la préparation, la journée de prise de vue, le maquillage, le repas, tous les fichiers retouchés, les tirages fine art signés et l’agrandissement encadré.',
  },
  {
    q: 'Combien de temps dure une séance ?',
    r: 'Une séance se déroule sur une journée. Je ne compte pas les heures : elle dure le temps qu’il faut pour que quelque chose arrive.',
  },
  {
    q: 'En quoi consiste la version avec œuvre dessinée ?',
    r: 'Après la séance, vous choisissez une image. Une dessinatrice en réalise un portrait à la main, d’après cette photographie. Vous repartez avec les deux — le tirage et le dessin. C’est la seule prestation de ce genre que je propose, et elle demande plusieurs semaines.',
  },
  {
    q: 'Je ne suis pas photogénique, comment être naturel devant un photographe ?',
    r: 'Personne n’est « photogénique » face à un photographe pressé. Se sentir soi devant un appareil demande deux choses : du temps, et quelqu’un qui n’exige rien. Vous n’aurez ni « souriez », ni « détendez-vous », ni compliments plaqués. C’est l’image finale qui fait la preuve.',
  },
  {
    q: 'Où se déroule la séance ?',
    r: 'Au studio de Gien, dans le Loiret, à 45 minutes d’Orléans et 1h30 de Paris — ou dans un lieu choisi ensemble : chez vous, en extérieur, dans un endroit qui compte pour vous.',
  },
];
---

<Base
  titre="Portrait d’art — Portrait: Art & Âme · Nathanaël Charpentier, portraitiste"
  description="Portrait: Art & Âme — une séance de portrait d’art à Gien, Orléans, Val de Loire ou Paris. Tirages fine art signés, tous les fichiers retouchés inclus. À partir de 1 200 €."
  lang="fr"
  alterne="/en/portraits/"
  entete="sombre"
  partage="portrait"
  partageAlt={alt(hero)}
>
  <Hero image={img(hero)} alt={alt(hero)}>
    <p class="label sur-image">Portrait</p>
    <h1>Art &amp; Âme</h1>
  </Hero>

  <section class="section">
    <div class="contenu recit mesure">
      <p class="ouverture apparait">Avant de vous photographier, <em class="italique">je prends le temps de vous rencontrer.</em></p>
      <p class="apparait">
        La séance commence loin de l’appareil : on parle, ou on se tait. Rien n’est à réussir.
        Je ne demande jamais de sourire, je ne dis jamais « détendez-vous ». Ces mots n’ont jamais
        détendu personne.
      </p>
      <p class="apparait">
        Je ne provoque rien. J’installe un espace, et ce qui doit apparaître finit par apparaître.
        Parfois vite. Parfois après des heures. C’est vous qui décidez du moment, souvent sans le
        savoir. Mon travail, c’est d’être prêt — et de vous accompagner. Par l’image, par mes mots,
        par ma présence, par mes silences.
      </p>
      <p class="apparait">
        Il y a des instants où je pose l’appareil. Ce sont souvent ceux qui précèdent les vraies
        images.
      </p>
      <p class="apparait">
        Le reportage m’accompagne jusqu’en séance. Des années à guetter l’instant dans la journée
        des autres m’ont appris à voir ce qui affleure — un geste, un relâchement, un silence — et
        à photographier avec discrétion quand c’est le moment. Certaines des images les plus justes
        d’une séance arrivent ainsi, sans que rien n’ait été demandé.
      </p>
    </div>
  </section>

  <section class="section deroule">
    <div class="contenu recit mesure">
      <p class="label apparait">Comment cela se passe</p>
      <p class="apparait">
        Tout commence avant la séance. On se parle — au studio, en visio ou au téléphone. On
        regarde des images ensemble et on construit un moodboard : les lumières, les matières, ce
        que vous voulez montrer, ce que vous préférez garder.
      </p>
      <p class="apparait">
        Le jour venu, vous n’avez rien à préparer. Maquillage si vous le souhaitez. On déjeune
        ensemble, et c’est souvent là que les choses se détendent pour de bon. Ensuite on
        photographie, sans regarder l’heure.
      </p>
      <p class="apparait">
        Tous les fichiers retouchés vous sont remis. Et vous repartez avec des tirages : cinq fine
        art en 20×30, signés, et un agrandissement A3+ encadré sur le même papier. Avec un
        diaporama de la séance, mis en musique.
      </p>
    </div>
  </section>

  <section class="section sombre">
    <div class="contenu">
      <Galerie photos={photos} />
    </div>
  </section>

  <section class="section">
    <div class="contenu recit mesure">
      <p class="apparait">
        Ne comptez pas sur moi pour les compliments : venant d’un photographe, vous ne les croiriez
        pas — et vous auriez raison. C’est l’image finale qui vous convaincra. Certains découvrent
        ce jour-là un visage que leurs proches connaissent depuis toujours, et qu’ils n’avaient
        jamais vu.
      </p>
      <p class="apparait">
        Ce que vous ne direz pas restera à vous. Un portrait n’a pas à tout montrer : ce qu’il
        garde fait sa profondeur.
      </p>
      <p class="apparait">
        Ce travail ne peut pas se faire seul. Je tiens l’espace ; ce qui s’y dépose vient de vous.
        C’est à deux que cela devient possible.
      </p>
    </div>
  </section>

  <Faq items={faq} titre="Avant d’écrire" />

  <div class="contenu mesure">
    <p class="depot">Portrait: Art &amp; Âme est une approche déposée. Elle se transmet, elle ne se copie pas.</p>
  </div>

  <Invitation lang="fr" phrase="Si ce portrait vous trotte dans la tête depuis un moment, écrivez quelques lignes." />
</Base>

<style>
  .sur-image { color: var(--ivoire); opacity: 0.8; }

  .recit {
    display: grid;
    gap: 1.9rem;
  }
  .ouverture {
    font-size: clamp(1.35rem, 1.1rem + 1.5vw, 2.4rem);
    line-height: 1.3;
  }
  .ouverture em { color: var(--bronze); }

  .deroule { padding-top: 0; }
  .deroule .label { margin-bottom: -0.6rem; }

  .depot {
    font-family: var(--sans);
    font-weight: 300;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: var(--pierre);
  }
</style>
