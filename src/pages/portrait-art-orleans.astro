---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Invitation from '../components/Invitation.astro';
import { Image } from 'astro:assets';

import p1 from '../assets/photos/portrait/portrait-art-ame-profil-pictural-nathanael-charpentier.jpg';
import p2 from '../assets/photos/portrait/portrait-homme-clair-obscur-nathanael-charpentier.jpg';

const faq = [
  {
    q: 'Combien coûte un portrait d’art près d’Orléans ?',
    r: 'Une séance Portrait: Art & Âme commence à 850 € — une demi-journée, une conversation avant les images, des tirages d’art à la fin. L’atelier se trouve à Gien, à 45 minutes d’Orléans ; la séance peut aussi se tenir chez vous ou dans un lieu choisi ensemble.',
  },
  {
    q: 'En quoi est-ce différent d’une séance photo classique ?',
    r: 'Une séance classique cherche une belle image de vous. Un portrait d’art cherche une image juste : ce que vous êtes, pas ce que vous montrez. Cela demande du temps — c’est la raison du format en demi-journée ou journée — et une façon de travailler où rien n’est exigé, jamais.',
  },
];
---

<Base
  titre="Portrait d’art à Orléans et dans le Loiret · Nathanaël Charpentier, portraitiste"
  description="Séance de portrait d’art près d’Orléans : Portrait: Art & Âme, en demi-journée ou journée, atelier à Gien à 45 minutes d’Orléans. À partir de 850 €."
  lang="fr"
  entete="clair"
>
  <section class="section entame">
    <div class="contenu">
      <p class="label apparait">Territoire</p>
      <h1 class="apparait">Portrait d’art<br />à Orléans</h1>

      <div class="mesure corps">
        <p class="apparait">
          Nathanaël Charpentier, Portraitiste de France, reçoit pour des séances de portrait
          d’art à 45 minutes d’Orléans — dans son atelier de Gien, chez vous, ou dans un lieu
          qui compte pour vous. La séance Portrait: Art &amp; Âme se déroule en demi-journée ou
          journée entière, et commence toujours par une conversation.
        </p>
        <p class="apparait">
          Entre Orléans et Gien, la Loire fait le trajet avec vous. Beaucoup viennent pour un cap :
          un anniversaire qui compte, une reconstruction, une transmission. D’autres pour
          quelqu’un : offrir une séance est une façon de dire à une personne qu’elle mérite
          d’être regardée longtemps.
        </p>
      </div>

      <div class="images">
        <figure class="apparait">
          <Image src={p1} alt="Portrait d’atelier de profil, lumière sculptée sur fond peint" widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, 40vw" quality={80} loading="lazy" />
        </figure>
        <figure class="apparait">
          <Image src={p2} alt="Portrait d’homme en clair-obscur, regard frontal" widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, 40vw" quality={80} loading="lazy" />
        </figure>
      </div>

      <p class="mesure apparait renvoi">
        Lire <a class="lien" href={u('/portrait/')}>la page Portrait — Art &amp; Âme</a>.
      </p>
    </div>
  </section>

  <Faq items={faq} titre="Questions fréquentes" />
  <Invitation lang="fr" />
</Base>

<style>
  .entame { padding-top: clamp(8rem, 16vh, 11rem); }
  h1 { margin: 0.4rem 0 2.6rem; }
  .corps { display: grid; gap: 1.7rem; margin-bottom: 3.5rem; }
  .images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: 56rem;
  }
  .images figure { margin: 0; }
  .renvoi { margin-top: 3rem; color: var(--pierre); }
  @media (max-width: 640px) { .images { grid-template-columns: 1fr; } }
</style>
