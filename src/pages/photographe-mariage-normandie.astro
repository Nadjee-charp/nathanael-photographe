---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Galerie from '../components/Galerie.astro';
import Faq from '../components/Faq.astro';
import Invitation from '../components/Invitation.astro';
import { galerie } from '../lib/photos';

// [I-04] [N-03] Normandie — jardins de Coppélia à Honfleur (12), Deauville (2),
// port de Honfleur (1), café de Trouville (1) = 16 images
const photos = galerie([
  'preparatifs-mariee-voile-clair-obscur-deauville-nathanael-charpentier.jpg',
  'detail-mains-robe-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'detail-main-epaule-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'complicite-pere-mariee-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'larmes-mariee-noir-et-blanc-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'etreinte-voile-noir-et-blanc-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'sortie-maries-voile-petales-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'rires-maries-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'baiser-mains-visage-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'profil-halo-lumiere-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'fou-rire-noir-et-blanc-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'voiture-ancienne-port-honfleur-mariage-nathanael-charpentier.jpg',
  'marie-porte-fete-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'soiree-etreinte-piste-jardins-coppelia-honfleur-nathanael-charpentier.jpg',
  'seance-engagement-cafe-trouville-nathanael-charpentier.jpg',
  'seance-jour-d-apres-vagues-deauville-nathanael-charpentier.jpg',
]);

const faq = [
  {
    q: 'Combien coûte un reportage de mariage en Normandie ?',
    r: 'Un reportage de mariage complet en Normandie — Deauville, Honfleur, Trouville — commence à 2 800 € avec Nathanaël Charpentier. Le déplacement depuis Gien est compris ; un seul mariage est photographié par week-end.',
  },
  {
    q: 'Qu’est-ce qu’une séance du jour d’après à la plage ?',
    r: 'C’est une séance organisée quelques jours après le mariage, souvent sur la plage : la robe a déjà eu sa journée, il ne reste que le jeu. On peut entrer dans l’eau, marcher longtemps, attendre la lumière. Ce sont souvent les images les plus libres de tout le reportage.',
  },
  {
    q: 'Photographiez-vous aussi les save-the-date et séances d’engagement ?',
    r: 'Oui. Se rencontrer avant le mariage change la journée elle-même : le jour J, il n’y a plus rien à expliquer. Ces séances se font à Trouville, Honfleur, Deauville ou dans un lieu qui compte pour vous.',
  },
];
---

<Base
  titre="Photographe de mariage en Normandie — Deauville, Honfleur, Trouville · Nathanaël Charpentier"
  description="Photographe de mariage en reportage en Normandie : Deauville, Honfleur, Trouville. Save-the-date, cérémonie et séance du jour d’après. À partir de 2 800 €."
  lang="fr"
  entete="clair"
  partage="normandie"
  partageAlt="Séance du jour d’après dans les vagues à Deauville, noir et blanc"
>
  <section class="section entame">
    <div class="contenu">
      <p class="label apparait">Territoire</p>
      <h1 class="apparait">Photographe de mariage<br />en Normandie</h1>

      <div class="mesure corps">
        <p class="apparait">
          Nathanaël Charpentier photographie des mariages en reportage sur la côte normande —
          Deauville, Honfleur, Trouville. Basé à Gien, dans le Loiret, il se déplace pour la
          journée entière, des préparatifs aux dernières danses.
        </p>
        <p class="apparait">
          La mer change la façon de photographier. Elle donne une lumière large, qui tourne vite,
          et un vent qui prend les voiles sans prévenir. Rien de tout cela ne se commande : on
          attend, on se place, et quand la vague monte, on est prêt. Les jardins de Coppélia à
          Honfleur, le port et ses voitures anciennes, les planches de Deauville — chaque lieu
          impose son rythme, et c’est très bien ainsi.
        </p>
        <p class="apparait">
          La Normandie a aussi cette habitude qui me plaît : on y prend le temps de plusieurs
          rendez-vous. Un save-the-date au café, la journée, puis une séance du jour d’après dans
          les vagues. À la troisième rencontre, on peut tout oser.
        </p>
      </div>
    </div>
  </section>

  <section class="section sombre">
    <div class="contenu">
      <Galerie photos={photos} />
    </div>
  </section>

  <section class="section renvois">
    <div class="contenu mesure">
      <p class="apparait">
        Lire le récit de <a class="lien" href={u('/journal/mariage-deauville/')}>Deauville</a>, voir
        <a class="lien" href={u('/mariage/')}>l’approche du mariage en reportage</a> ou les mariages
        à <a class="lien" href={u('/photographe-mariage-paris/')}>Paris</a>.
      </p>
    </div>
  </section>

  <Faq items={faq} titre="Questions fréquentes" />
  <Invitation lang="fr" phrase="La mer, un jardin, une maison de famille — écrivez-moi la date et le lieu." />
</Base>

<style>
  .entame { padding-top: clamp(7rem, 16vh, 11rem); }
  h1 { margin: 0.4rem 0 2.6rem; }
  .corps { display: grid; gap: 1.7rem; }
  .renvois { padding-block: clamp(3rem, 8vh, 5rem); color: var(--pierre); }
</style>
