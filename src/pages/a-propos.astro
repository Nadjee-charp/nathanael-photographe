---
import Base from '../layouts/Base.astro';
import Invitation from '../components/Invitation.astro';
import { Image } from 'astro:assets';
import { SITE } from '../lib/site';
import { img, alt } from '../lib/photos';

const manifeste = 'portrait-penombre-manifeste-nathanael-charpentier.jpg';
const volute = 'volute-contrebasse-nathanael-charpentier.jpg';
const fleur = 'nathanael-charpentier-fleur-nathanael-charpentier.jpg';

// La couleur au centre, le noir et blanc de part et d'autre.
const coulisses = [
  {
    fichier: 'nathanael-charpentier-scene-piano-nathanael-charpentier.jpg',
    legende: 'Théâtre des Champs-Élysées, Paris.',
  },
  {
    fichier: 'nathanael-charpentier-salle-concert-nathanael-charpentier.jpg',
    legende: 'Salle Cortot, Paris.',
  },
  {
    fichier: 'nathanael-charpentier-appareil-sourire-nathanael-charpentier.jpg',
    legende: 'Les 30 ans de Cosmetic Valley, château de Chambord.',
  },
];

// [M-22] + ligne presse/institutions (note du 14/08/2026).
// Chaque distinction tient sur deux lignes : l'intitulé, puis ce qu'il recouvre.
const preuves = [
  { titre: 'Portraitiste de France', detail: 'Distinction 2021' },
  {
    titre: 'Family Photojournalist Association',
    detail: 'Top 10 mondial 2020 · 3ᵉ européen · 1ᵉʳ français',
  },
  { titre: 'Fearless Photographers', detail: 'XP Photographer' },
  {
    titre: 'Collectif Carmin',
    detail: 'Co-fondateur et président, premier collectif français de photographes d’accouchement',
  },
  {
    titre: '« La Pudeur de l’Intrus »',
    detail: 'Conférence donnée au Cocktail The Conv, convention de photographes, Lyon, 2026',
  },
  {
    titre: 'Comité Miss France',
    detail: 'Portraits officiels de Miss Loiret et de Miss Centre-Val de Loire',
  },
  {
    titre: 'Institutions',
    detail:
      'Photographies utilisées par la Philharmonie de Paris, la Philharmonie de Saint-Pétersbourg, le Théâtre des Champs-Élysées et la Salle Gaveau',
  },
  {
    titre: 'Près de vingt ans de métier',
    detail: 'Du reportage de mariage au portrait d’introspection',
  },
];
---

<Base
  titre="À propos — le manifeste · Nathanaël Charpentier, photographe portraitiste"
  description="Ce en quoi Nathanaël Charpentier croit, ce qu’il refuse. Portraitiste de France 2021, co-fondateur du Studio NathSam, auteur de la conférence « La Pudeur de l’Intrus »."
  lang="fr"
  alterne="/en/about/"
  partage="a-propos"
  partageAlt={alt(manifeste)}
>
  <section class="section entame">
    <div class="contenu manifeste">
      <figure class="colonne-image apparait">
        <Image
          src={img(manifeste)}
          alt={alt(manifeste)}
          widths={[500, 750, 1100, 1280]}
          sizes="(max-width: 900px) 100vw, 36vw"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="colonne-texte">
        <p class="label apparait">À propos</p>
        <h1 class="apparait">Le manifeste</h1>
        <div class="recit">
          <p class="apparait">
            La place du photographe est un privilège. Je ne la prends jamais pour acquise.
            On m’ouvre des journées, des maisons, des visages, des moments intimes, des moments
            privilégiés. J’y entre comme on entre chez quelqu’un : invité, et conscient de l’être.
          </p>
          <p class="apparait">
            Je crois que ce qui compte ne se capte pas. Ça se mérite : à force de silence,
            d’attention, de temps laissé.
          </p>
          <p class="apparait">
            Je refuse de fabriquer. Une larme provoquée est une effraction ; une larme accueillie
            est une confiance. Je fais la différence.
          </p>
          <p class="apparait">
            Il y a aussi les confidences. Une confidence faite devant l’appareil est souvent une
            confidence qu’on s’autorise enfin, qu’on se fait d’abord à soi-même. Elle ne
            m’appartient pas : elle reste à vous.
          </p>
          <p class="apparait">
            Je refuse aussi de tout montrer. Un portrait qui dit tout ne dit rien : je laisse à
            chacun sa part gardée.
          </p>
          <p class="apparait">
            La musique m’a appris l’essentiel : savoir quand ne pas jouer.
          </p>
          <p class="apparait">
            Ce que je fais est difficile à résumer. Il m’arrive d’en parler sur scène, en
            conférence, à des salles de photographes. Mais devant vous, ça tient en une phrase :
            <em class="italique">que dois-je faire pour ne rien abîmer ?</em>
          </p>
          <p class="apparait">
            Mon travail se termine quand l’appareil se range. Ce que j’emporte : des images. Ce que
            je laisse : des images aussi, une expérience, un moment partagé, et parfois un petit
            morceau d’histoire commune, pour avoir été là un jour qui comptait.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section sombre musique">
    <div class="contenu duo-musique">
      <div class="colonne-texte">
        <p class="label apparait">La bonne place</p>
        <p class="citation apparait">« Y être suffisamment pour qu’on m’oublie. »</p>
        <p class="apparait detail-musique">
          Avant l’appareil, il y a eu la musique : le saxophone, la guitare, des chansons écrites
          et composées. Et sur scène, un modèle discret : le contrebassiste, qui porte toute une
          pièce sans jamais prendre le solo. C’est la place que je cherche.
        </p>
      </div>
      <figure class="colonne-image apparait">
        <Image
          src={img(volute)}
          alt={alt(volute)}
          widths={[500, 750, 1100, 1500]}
          sizes="(max-width: 900px) 100vw, 42vw"
          quality={88}
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="section preuves">
    <div class="contenu duo-preuves">
      <div class="colonne-liste">
        <p class="label apparait">Montré, pas revendiqué</p>
        <ul class="liste-preuves">
          {preuves.map((p) => (
            <li class="apparait">
              <span class="preuve-titre">{p.titre}</span>
              <span class="preuve-detail">{p.detail}</span>
            </li>
          ))}
        </ul>
        <p class="maison apparait">
          Nathanaël Charpentier est le nom derrière l’expertise photographie du <a class="lien" href={SITE.studioUrl} rel="noopener">Studio NathSam</a>, la maison fondée
          à Gien avec Samuel Dejours : le studio, la vidéo, les séances du quotidien.
          Ici : le portrait d’art et le mariage en reportage.
        </p>
      </div>

      <figure class="portrait-preuves apparait">
        <Image
          src={img(fleur)}
          alt={alt(fleur)}
          widths={[500, 750, 1100, 1500]}
          sizes="(max-width: 900px) 100vw, 32vw"
          quality={88}
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="section coulisses">
    <div class="contenu">
      <p class="label apparait">Les coulisses</p>
      <div class="triptyque">
        {coulisses.map((c) => (
          <figure class="apparait">
            <Image
              src={img(c.fichier)}
              alt={alt(c.fichier)}
              widths={[500, 750, 1100]}
              sizes="(max-width: 900px) 100vw, 30vw"
              quality={88}
              loading="lazy"
            />
            <figcaption>{c.legende}</figcaption>
          </figure>
        ))}
      </div>
      <p class="credit apparait">
        Photographies par Samuel Dejours, <a class="lien" href={SITE.studioUrl} rel="noopener">Studio NathSam</a>.
      </p>
    </div>
  </section>

  <Invitation lang="fr" />
</Base>

<style>
  .entame { padding-top: clamp(3rem, 7vh, 4.5rem); }

  /* Le texte fait au moins une fois et demie la largeur de l'image : c'est cette
     proportion qui tient la page, l'image ne doit jamais concurrencer le manifeste. */
  .manifeste {
    display: grid;
    grid-template-columns: 5fr 8fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .manifeste figure { margin: 0; }
  .colonne-texte h1 { margin: 0.4rem 0 2.2rem; }

  .recit { display: grid; gap: 1.7rem; max-width: 58ch; }
  .recit em { color: var(--bronze-texte); }

  .duo-musique {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .duo-musique figure { margin: 0; }

  .citation {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2.8rem);
    font-weight: 300;
    line-height: 1.3;
    margin-block: 1.4rem 2rem;
    max-width: 18ch;
  }
  .detail-musique { max-width: 46ch; color: var(--pierre-claire); }

  .duo-preuves {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .liste-preuves {
    list-style: none;
    padding: 0;
    margin: 2.2rem 0 3rem;
    display: grid;
  }
  /* Deux lignes par distinction : l'intitulé, puis ce qu'il recouvre. */
  .liste-preuves li {
    display: grid;
    gap: 0.3rem;
    padding-block: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--encre) 14%, transparent);
  }
  .liste-preuves li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--encre) 14%, transparent);
  }
  .preuve-titre {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze-texte);
  }
  .preuve-detail {
    font-family: var(--serif);
    font-size: 1.08rem;
    line-height: 1.5;
    max-width: 46ch;
  }

  .portrait-preuves { margin: 0; }
  .maison { max-width: 58ch; color: var(--pierre); font-size: 0.98rem; }

  .coulisses { padding-top: 0; }
  .triptyque {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.8rem, 2vw, 1.6rem);
    margin-top: 1.6rem;
    align-items: start;
  }
  .triptyque figure { margin: 0; }
  .triptyque figcaption {
    margin-top: 0.8rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    line-height: 1.5;
    color: var(--pierre);
  }
  .credit {
    margin-top: 2rem;
    text-align: right;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--pierre);
  }

  @media (max-width: 900px) {
    .manifeste,
    .duo-musique,
    .duo-preuves { grid-template-columns: 1fr; }
    .duo-musique .colonne-image { order: -1; }
    .triptyque { grid-template-columns: 1fr; gap: 1.6rem; }
    .credit { text-align: left; }
  }
</style>
