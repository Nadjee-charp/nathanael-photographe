---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Galerie from '../components/Galerie.astro';
import Faq from '../components/Faq.astro';
import Invitation from '../components/Invitation.astro';
import { galerie } from '../lib/photos';

// [I-04] Val de Loire — la Bourdaisière (2), Pont-Chevron (2), Grand Courtoiseau (1)
const photos = galerie([
  'houppa-crepuscule-chateau-la-bourdaisiere-montlouis-sur-loire-nathanael-charpentier.jpg',
  'voile-parc-chateau-pont-chevron-noir-et-blanc-nathanael-charpentier.jpg',
  'mariee-sourire-voile-jardin-grand-courtoiseau-loiret-nathanael-charpentier.jpg',
  'danse-tendre-chateau-pont-chevron-ouzouer-sur-trezee-nathanael-charpentier.jpg',
  'premiere-danse-chateau-la-bourdaisiere-nathanael-charpentier.jpg',
]);

const faq = [
  {
    q: 'Combien coûte un photographe de mariage pour un château du Val de Loire ?',
    r: 'Pour une journée complète de reportage dans un château ou un domaine du Val de Loire, les photographes établis se situent entre 2 500 et 5 000 €. Nathanaël Charpentier photographie à partir de 2 800 €, de Gien à Tours en passant par la Sologne, avec un seul mariage par week-end.',
  },
  {
    q: 'Faut-il réserver longtemps à l’avance ?',
    r: 'Pour un samedi de mai à septembre dans un domaine du Val de Loire, comptez 12 à 18 mois d’avance. Les demandes se font par le formulaire de contact, avec la date et le lieu si vous les avez.',
  },
  {
    q: 'Dans quels châteaux de la Loire Nathanaël Charpentier a-t-il photographié ?',
    r: 'Le château de la Bourdaisière à Montlouis-sur-Loire, le château du Pont-Chevron à Ouzouer-sur-Trézée et le jardin du Grand Courtoiseau dans le Loiret, notamment. Basé à Gien, il intervient de Sully-sur-Loire à Tours, et se déplace partout où la journée a lieu.',
  },
];
---

<Base
  titre="Photographe mariage Val de Loire — châteaux & domaines · Nathanaël Charpentier"
  description="Reportage de mariage dans les châteaux et domaines du Val de Loire et de Sologne, à 1h30 de Paris. Nathanaël Charpentier intervient de Gien à Tours. À partir de 2 800 €."
  lang="fr"
  alterne="/en/loire-valley-wedding-photographer/"
  entete="clair"
  partage="val-de-loire"
  partageAlt="Cérémonie sous la houppa au crépuscule, château de la Bourdaisière"
>
  <section class="section entame">
    <div class="contenu">
      <p class="label apparait">Territoire</p>
      <h1 class="apparait">Photographe de mariage<br />en Val de Loire</h1>

      <div class="mesure corps">
        <p class="apparait">
          Nathanaël Charpentier photographie des mariages en reportage dans les châteaux et
          domaines du Val de Loire et de Sologne. Basé à Gien (Loiret), il intervient de
          Sully-sur-Loire à Tours, à 1h30 de Paris, et se déplace partout où la journée a lieu.
        </p>
        <p class="apparait">
          Le Val de Loire a une particularité que les couples découvrent vite : des lieux classés
          au patrimoine mondial, des domaines aux proportions de palais, et des journées qui
          restent des journées de famille. C’est un terrain rêvé pour le reportage. La pierre
          claire prend la lumière du soir comme nulle part ailleurs ; les grands escaliers font des
          entrées qu’aucune mise en scène n’améliorerait ; et les parcs sont assez vastes pour que
          chacun oublie l’appareil.
        </p>
        <p class="apparait">
          La façon de travailler ne change pas d’un lieu à l’autre : les instants que personne ne
          dirige, gardés tels qu’ils ont eu lieu. Le château fait le décor ; votre journée fait les
          images.
        </p>
      </div>
    </div>
  </section>

  <section class="section sombre">
    <div class="contenu">
      <Galerie photos={photos} />
    </div>
  </section>

  <section class="section renvois">
    <div class="contenu mesure">
      <p class="apparait">
        Voir <a class="lien" href={u('/mariage/')}>l’approche du mariage en reportage</a>, le récit
        de <a class="lien" href={u('/journal/mariage-domaine-de-murtoli-corse/')}>Murtoli</a>, ou
        les mariages à <a class="lien" href={u('/photographe-mariage-paris/')}>Paris</a> et en <a class="lien" href={u('/photographe-mariage-normandie/')}>Normandie</a>.
      </p>
    </div>
  </section>

  <Faq items={faq} titre="Questions fréquentes" />
  <Invitation lang="fr" phrase="Un château, une grange, un jardin de famille : dites-moi où." />
</Base>

<style>
  .entame { padding-top: clamp(7rem, 16vh, 11rem); }
  h1 { margin: 0.4rem 0 2.6rem; }
  .corps { display: grid; gap: 1.7rem; }
  .renvois { padding-block: clamp(3rem, 8vh, 5rem); color: var(--pierre); }
</style>
