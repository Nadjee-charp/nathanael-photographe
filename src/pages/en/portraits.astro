---
import Base from '../../layouts/Base.astro';
import HeroDiaporama from '../../components/HeroDiaporama.astro';
import Galerie from '../../components/Galerie.astro';
import Faq from '../../components/Faq.astro';
import Invitation from '../../components/Invitation.astro';
import { img, bandeau, HERO_PORTRAIT } from '../../lib/photos';

const photosHero = bandeau(HERO_PORTRAIT);

// Même sélection et même ordre que la page française : jamais deux images de la même
// personne côte à côte, alternance couleur / noir et blanc et sombre / clair.
