---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Galerie from '../../components/Galerie.astro';
import Faq from '../../components/Faq.astro';
import Invitation from '../../components/Invitation.astro';
import { img } from '../../lib/photos';

const hero = 'portrait-art-ame-main-visage-noir-et-blanc-nathanael-charpentier.jpg';

const photos = [
  ['portrait-art-ame-pensive-fond-peint-nathanael-charpentier.jpg', 'Pensive portrait seated against a painted backdrop'],
  ['portrait-art-ame-lumiere-laterale-studio-gien-nathanael-charpentier.jpg', 'Portrait in side light at the Gien studio, black and white'],
  ['portrait-art-ame-larme-essuyee-nathanael-charpentier.jpg', 'A tear wiped away during a Portrait: Art & Âme session'],
  ['portrait-art-ame-silhouette-fenetre-lampe-nathanael-charpentier.jpg', 'Silhouette seated by a window, a lamp glowing in the dark'],
  ['portrait-art-ame-miroir-rond-nathanael-charpentier.jpg', 'Reflection in a round mirror during a portrait session'],
  ['portrait-cheveux-regard-baisse-noir-et-blanc-nathanael-charpentier.jpg', 'Hair in the light, eyes lowered, portrait in black and white'],
  ['portrait-main-pudeur-noir-et-blanc-nathanael-charpentier.jpg', 'A hand raised before the face, portrait in black and white'],
  ['portrait-robe-noire-salon-chateau-de-villette-nathanael-charpentier.jpg', 'Portrait in a black dress in the drawing room of a French château'],
  ['robe-blanche-mouvement-escalier-noir-et-blanc-nathanael-charpentier.jpg', 'White dress in movement on a staircase, black and white'],
  ['portrait-homme-lin-drape-clair-nathanael-charpentier.jpg', 'Portrait of a man in a linen shirt against a pale drape'],
  ['portrait-homme-chapeau-melon-studio-gien-nathanael-charpentier.jpg', 'Portrait of a man in a bowler hat and round glasses, Gien studio'],
  ['portrait-profil-penombre-nathanael-charpentier.jpg', 'Profile sculpted by shadow'],
].map(([f, a]) => ({ img: img(f), alt: a }));

const faq = [
  {
    q: 'What does the Art & Âme portrait experience include?',
    r: 'A Portrait: Art & Âme session with Nathanaël Charpentier includes a preparation meeting, a moodboard built together, a full day of shooting, make-up if you wish, lunch, every retouched file, five signed 20×30 fine-art prints, a framed and signed A3+ enlargement, and a slideshow of the session set to music. From €1,200.',
  },
  {
    q: 'Are the digital files included?',
    r: 'Yes. Every retouched file from the session is handed over, at no extra cost and with no imposed selection. They are yours. The signed fine-art prints and the framed enlargement are included on top, within the same price.',
  },
  {
    q: 'I am not photogenic — how can I feel natural in front of a camera?',
    r: 'Nobody is “photogenic” in front of a photographer in a hurry. Feeling like yourself takes two things: time, and someone who demands nothing. You will hear no “smile”, no “relax”, no rehearsed compliments. The final image is what convinces you.',
  },
];
---

<Base
  titre="Fine-art portrait experience in the Loire Valley · Nathanaël Charpentier"
  description="The Art & Âme portrait experience: a full-day fine-art portrait session in the Loire Valley, an hour and a half from Paris. Signed fine-art prints included. From €1,200."
  lang="en"
  alterne="/portrait/"
  entete="sombre"
  partage="portrait"
  partageAlt="Portrait with a hand against the face, frontal gaze, black and white"
>
  <Hero image={img(hero)} alt="Portrait with a hand against the face, frontal gaze, black and white">
    <p class="label sur-image">Portraits</p>
    <h1>The Experience</h1>
  </Hero>

  <section class="section">
    <div class="contenu recit mesure">
      <p class="ouverture apparait">Before photographing you, <em class="italique">I take the time to meet you.</em></p>
      <p class="apparait">
        The session begins far from the camera: we talk, or we stay silent. Nothing has to be
        achieved. I never ask for a smile, I never say “relax”. Those words have never relaxed
        anyone.
      </p>
      <p class="apparait">
        I force nothing. I hold a space, and what needs to appear ends up appearing. Sometimes
        quickly. Sometimes after hours. You decide the moment — often without knowing it. My work
        is to be ready, and to accompany you: through the image, through my words, through my
        presence, through my silences.
      </p>
      <p class="apparait">
        Do not count on me for compliments: coming from a photographer, you would not believe them
        — and you would be right. The final image is what will convince you. Some people discover
        that day a face their family has known for ever, and that they had never seen.
      </p>
      <p class="apparait">
        This work cannot be done alone. I hold the space; what settles into it comes from you. It
        takes two for it to become possible.
      </p>
    </div>
  </section>

  <section class="section sombre">
    <div class="contenu">
      <Galerie photos={photos} />
    </div>
  </section>

  <Faq items={faq} titre="Before you write" />
  <Invitation lang="en" />
</Base>

<style>
  .sur-image { color: var(--ivoire); opacity: 0.8; }
  .recit { display: grid; gap: 1.9rem; }
  .ouverture { font-size: clamp(1.35rem, 1.1rem + 1.5vw, 2.4rem); line-height: 1.3; }
  .ouverture em { color: var(--bronze); }
</style>
