---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Galerie from '../../components/Galerie.astro';
import Faq from '../../components/Faq.astro';
import Invitation from '../../components/Invitation.astro';

import heroImg from '../../assets/photos/portrait/portrait-lampe-ambree-nathanael-charpentier.jpg';
import p01 from '../../assets/photos/portrait/portrait-art-ame-profil-pictural-nathanael-charpentier.jpg';
import p02 from '../../assets/photos/portrait/portrait-regard-mains-visage-nathanael-charpentier.jpg';
import p03 from '../../assets/photos/portrait/portrait-art-ame-larme-lumiere-nathanael-charpentier.jpg';
import p05 from '../../assets/photos/portrait/portrait-violoncelle-contre-jour-nathanael-charpentier.jpg';
import p06 from '../../assets/photos/portrait/portrait-homme-clair-obscur-nathanael-charpentier.jpg';
import p09 from '../../assets/photos/portrait/portrait-fine-art-dos-collier-nathanael-charpentier.jpg';
import p10 from '../../assets/photos/portrait/portrait-violoncelliste-rembrandt-nathanael-charpentier.jpg';
import p11 from '../../assets/photos/portrait/portrait-taches-rousseur-nathanael-charpentier.jpg';
import p13 from '../../assets/photos/portrait/portrait-regard-dense-nathanael-charpentier.jpg';
import p16 from '../../assets/photos/portrait/portrait-beret-chesterfield-nathanael-charpentier.jpg';

const photos = [
  { img: p01, alt: 'Woman seated in profile, sculpted light on painted backdrop' },
  { img: p02, alt: 'Frontal gaze, hands to the face, dark background' },
  { img: p03, alt: 'A tear on the cheek, eyes turned to the light, black and white' },
  { img: p05, alt: 'Silhouette embracing a cello against amber backlight' },
  { img: p06, alt: 'Bearded man, frontal gaze in chiaroscuro' },
  { img: p09, alt: 'Bare back emerging from darkness, inverted necklace, black and white' },
  { img: p10, alt: 'Cellist in a white dress, Rembrandt chiaroscuro' },
  { img: p11, alt: 'Extreme close-up, freckles, hand at the neck, black and white' },
  { img: p13, alt: 'Frontal portrait, long hair, dense gaze, black and white' },
  { img: p16, alt: 'Woman in a beret on a chesterfield, copper and green palette' },
];

const faq = [
  {
    q: 'What is the Art & Âme portrait experience?',
    r: 'A fine-art portrait session lasting half a day to a full day, in Gien (Loire Valley) or a place chosen together. It begins with a conversation, never with photographs. You leave with fine-art prints. From €850.',
  },
  {
    q: 'I am not photogenic — how can I feel natural in front of a camera?',
    r: 'Nobody is “photogenic” in front of a photographer in a hurry. Feeling like yourself in front of a camera takes two things: time, and someone who demands nothing. You will hear no “smile”, no “relax”, no rehearsed compliments. The final image is what convinces you — not words.',
  },
];
---

<Base
  titre="Fine-art portrait experience in the Loire Valley · Nathanaël Charpentier"
  description="The Art & Âme portrait experience: a half-day or full-day fine-art portrait session in the Loire Valley, one hour from Paris. Fine-art prints. From €850."
  lang="en"
  alterne="/portrait/"
  entete="sombre"
>
  <Hero image={heroImg} alt="Woman under a wall lamp, pool of amber light in the dark">
    <p class="label" style="color: var(--ivoire); opacity: 0.8;">Portraits</p>
    <h1>The Experience</h1>
  </Hero>

  <section class="section">
    <div class="contenu recit mesure">
      <p class="ouverture apparait">You do not come here to be photographed. <em class="italique">You come to be met.</em></p>
      <p class="apparait">
        The session begins far from the camera: we talk, or we stay silent. Nothing has to be
        achieved. I never ask for a smile, I never say “relax”. Those words have never relaxed
        anyone.
      </p>
      <p class="apparait">
        I force nothing. I hold a space, and what needs to appear ends up appearing. Sometimes
        quickly. Sometimes after hours. You decide the moment — often without knowing it. My work
        is to be ready, and to damage nothing.
      </p>
      <p class="apparait">
        You will not be flattered. A photographer’s compliments are worthless: you would put them
        down to the trade. The final image will speak — and it does not lie.
      </p>
      <p class="apparait">
        This work cannot be done alone. I hold the space; what settles into it comes from you.
        It takes two for the mask to agree to fall.
      </p>
    </div>
  </section>

  <section class="section sombre">
    <div class="contenu">
      <Galerie photos={photos} />
    </div>
  </section>

  <Faq items={faq} titre="Before you write" />
  <Invitation lang="en" />
</Base>

<style>
  .recit { display: grid; gap: 1.9rem; }
  .ouverture { font-size: clamp(1.5rem, 1.15rem + 1.6vw, 2.4rem); line-height: 1.3; }
  .ouverture em { color: var(--bronze); }
</style>
