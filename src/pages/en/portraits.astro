  ['detail-main-penombre-portrait-nathanael-charpentier.jpg', 'Detail of a hand in low light during a portrait session'],
  ['ludmila-berlinskaya-scene-nathanael-charpentier.jpg', 'Pianist on stage during a concert'],
  ['portrait-cheveux-regard-baisse-noir-et-blanc-nathanael-charpentier.jpg', 'Hair in the light, eyes lowered, portrait in black and white'],
  ['portrait-art-ame-pensive-fond-peint-nathanael-charpentier.jpg', 'Pensive portrait seated against a painted backdrop'],
  ['portrait-noir-et-blanc-ombre-mur-studio-gien-nathanael-charpentier.jpg', 'Arm raised and shadow cast on the wall, black and white, Gien studio'],
  ['portrait-justine-bourrelier-costume-sombre-studio-gien-nathanael-charpentier.jpg', 'Portrait in a dark suit on a leather armchair, Gien studio'],
