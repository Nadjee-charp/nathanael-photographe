  ['portrait-profil-penombre-nathanael-charpentier.jpg', 'Profile sculpted by shadow'],
  ['portrait-justine-bourrelier-drape-ivoire-studio-gien-nathanael-charpentier.jpg', 'Portrait against an ivory drape, Gien studio'],
  ['detail-mains-croisees-noir-et-blanc-nathanael-charpentier.jpg', 'Crossed hands, detail in black and white'],
