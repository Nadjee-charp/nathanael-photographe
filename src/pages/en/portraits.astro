  ['portrait-homme-exterieur-brique-portail-nathanael-charpentier.jpg', 'Portrait of a man outdoors against brick and a green gate'],
  ['portrait-maelle-menotti-noir-et-blanc-scene-nathanael-charpentier.jpg', 'Portrait in black and white under stage light'],
