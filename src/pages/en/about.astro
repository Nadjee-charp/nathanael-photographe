---
import Base from '../../layouts/Base.astro';
import Invitation from '../../components/Invitation.astro';
import { Image } from 'astro:assets';
import { SITE } from '../../lib/site';

import portraitNath from '../../assets/photos/apropos/nathanael-charpentier-photographe-portraitiste-gien.jpg';
---

<Base
  titre="About — the manifesto · Nathanaël Charpentier, portrait photographer"
  description="What Nathanaël Charpentier believes, and what he refuses. Portraitiste de France, co-founder of Studio NathSam, speaker — Loire Valley, France."
  lang="en"
  alterne="/a-propos/"
  entete="clair"
>
  <section class="section entame">
    <div class="contenu duo-colonnes">
      <div class="colonne-image apparait">
        <Image
          src={portraitNath}
          alt="Nathanaël Charpentier, portrait photographer, seated by columns, camera at rest"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 42vw"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="colonne-texte">
        <p class="label apparait">About</p>
        <h1 class="apparait">The manifesto</h1>
        <div class="recit">
          <p class="apparait">
            I believe a photographer’s place is a privilege, never a right. People open their
            days, their homes, their faces to me: I enter the way you enter someone’s house —
            invited, and aware of it.
          </p>
          <p class="apparait">
            I believe what matters cannot be captured. It must be earned — through silence,
            attention, and time left to the other.
          </p>
          <p class="apparait">
            I refuse to manufacture. A provoked tear is a break-in; a welcomed tear is a trust.
            I know the difference, and I honour it.
          </p>
          <p class="apparait">
            I also refuse to show everything. A portrait that tells all tells nothing: I leave
            everyone their kept share.
          </p>
          <p class="apparait">
            Music taught me the essential: knowing when not to play.
          </p>
          <p class="apparait">
            My work is done when I become transparent again. What I take with me: images.
            What I leave behind: nothing.
          </p>
        </div>
        <p class="maison apparait">
          Nathanaël Charpentier is the name behind the photographic eye of
          <a class="lien" href={SITE.studioUrl} rel="noopener">Studio NathSam</a>, the house he
          co-founded in Gien, Loire Valley. Portraitiste de France · TOP 10 photographer 2020 ·
          Fearless Photographers.
        </p>
      </div>
    </div>
  </section>

  <Invitation lang="en" />
</Base>

<style>
  .entame { padding-top: clamp(8rem, 16vh, 11rem); }
  .duo-colonnes {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .colonne-texte h1 { margin: 0.4rem 0 2.2rem; }
  .recit { display: grid; gap: 1.7rem; max-width: 58ch; }
  .maison { margin-top: 2.6rem; color: var(--pierre); font-size: 0.95rem; max-width: 52ch; }
  @media (max-width: 900px) { .duo-colonnes { grid-template-columns: 1fr; } }
</style>
