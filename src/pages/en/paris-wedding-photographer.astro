---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import Galerie from '../../components/Galerie.astro';
import Faq from '../../components/Faq.astro';
import Invitation from '../../components/Invitation.astro';
import { img } from '../../lib/photos';

// [N-02] Même sélection et même ordre que la page française.
const photos = [
  ['mariee-colonnade-lanternes-palais-royal-paris-nathanael-charpentier.jpg', 'Bride alone beneath the colonnade and lanterns of the Palais-Royal, Paris'],
  ['couple-bouche-de-metro-guimard-paris-nathanael-charpentier.jpg', 'The couple in front of a Guimard métro entrance, Paris'],
  ['baiser-balustrade-palais-royal-paris-nathanael-charpentier.jpg', 'A kiss against the balustrade of the arcades, Palais-Royal, Paris'],
  ['couple-rue-deserte-louvre-paris-nathanael-charpentier.jpg', 'The couple in the middle of an empty street outside the Louvre'],
  ['maries-pont-bir-hakeim-tour-eiffel-paris-nathanael-charpentier.jpg', 'The couple on the pont de Bir-Hakeim facing the Eiffel Tower, black and white'],
  ['couple-escalier-colimacon-bleu-paris-nathanael-charpentier.jpg', 'The couple in the blue spiral staircase, Paris'],
  ['mariee-chapeau-cape-balustrade-palais-royal-paris-nathanael-charpentier.jpg', 'The bride in a hat, cape spread across the balustrade, Palais-Royal'],
  ['marie-pose-manteau-epaules-mariee-arcades-paris-nathanael-charpentier.jpg', 'The groom lays a coat over the bride’s shoulders, under the arcades'],
  ['etreinte-galerie-palais-royal-paris-nathanael-charpentier.jpg', 'An embrace in the bright gallery of the Palais-Royal, Paris'],
  ['baiser-pavillon-colbert-louvre-paris-nathanael-charpentier.jpg', 'A kiss in front of the Colbert pavilion of the Louvre, black and white'],
  ['couple-colonnade-louvre-paris-nathanael-charpentier.jpg', 'The couple face to face beneath the colonnade of the Louvre, Paris'],
  ['maries-colonnade-pont-bir-hakeim-paris-nathanael-charpentier.jpg', 'The couple within the colonnade of the pont de Bir-Hakeim, Paris'],
  ['mariee-devanture-atelier-photo-noir-et-blanc-paris-nathanael-charpentier.jpg', 'The bride passing a photography studio front, black and white, Paris'],
  ['couple-pont-alexandre-iii-grand-palais-paris-nathanael-charpentier.jpg', 'A kiss on the pont Alexandre-III, the dome of the Grand Palais behind'],
  ['couple-front-contre-front-banc-paris-nathanael-charpentier.jpg', 'Forehead to forehead on a Paris bench'],
  ['maries-tour-eiffel-colonnade-bir-hakeim-paris-nathanael-charpentier.jpg', 'The couple facing the Eiffel Tower between the columns of Bir-Hakeim'],
