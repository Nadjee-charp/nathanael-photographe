---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
---

<Base
  titre="Message sent · Nathanaël Charpentier"
  description="Your message has arrived. A personal reply within 48 hours."
  lang="en"
  alterne="/merci/"
  indexer={false}
>
  <section class="section entame">
    <div class="contenu centre">
      <hr class="filet" />
      <h1>Your message has arrived.</h1>
      <p class="mesure">
        I will reply personally, within 48 hours. In the meantime, the <a class="lien" href={u('/en/')}>portfolio</a> is waiting for you.
      </p>
    </div>
  </section>
</Base>

<style>
  .entame { padding-top: clamp(10rem, 22vh, 15rem); min-height: 75vh; }
  .centre { display: grid; justify-items: center; text-align: center; gap: 2rem; }
</style>
