---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Galerie from '../../components/Galerie.astro';
import Faq from '../../components/Faq.astro';
import Invitation from '../../components/Invitation.astro';
import { img } from '../../lib/photos';

const hero = 'mariage-plage-la-palmyre-voile-couchant-nathanael-charpentier.jpg';

const photos = [
  ['preparatifs-mariee-voile-clair-obscur-deauville-nathanael-charpentier.jpg', 'Bride beneath her veil in chiaroscuro during the preparations in Deauville'],
  ['complicite-pere-mariee-jardins-coppelia-honfleur-nathanael-charpentier.jpg', 'A father and his daughter laughing together on the wedding day, Honfleur'],
  ['larmes-mariee-noir-et-blanc-jardins-coppelia-honfleur-nathanael-charpentier.jpg', 'The bride in tears by a window, Coppélia gardens in Honfleur, black and white'],
  ['ceremonie-applaudissements-chateau-saint-martin-du-tertre-nathanael-charpentier.jpg', 'Guests applauding during the ceremony at the château of Saint-Martin-du-Tertre'],
  ['houppa-crepuscule-chateau-la-bourdaisiere-montlouis-sur-loire-nathanael-charpentier.jpg', 'Ceremony beneath the chuppah at dusk, château de la Bourdaisière, Loire Valley'],
  ['sortie-maries-voile-petales-jardins-coppelia-honfleur-nathanael-charpentier.jpg', 'The couple leaving under a shower of petals, veil in the wind, Honfleur'],
  ['grand-escalier-entree-maries-chateau-saint-martin-du-tertre-nathanael-charpentier.jpg', 'The couple entering down the grand staircase of a French château'],
  ['etreinte-maries-noir-et-blanc-nathanael-charpentier.jpg', 'The couple embracing in a field, eyes closed, black and white'],
  ['rires-maries-jardins-coppelia-honfleur-nathanael-charpentier.jpg', 'The couple laughing face to face, Coppélia gardens in Honfleur, black and white'],
  ['mariee-colonnade-lanternes-palais-royal-paris-nathanael-charpentier.jpg', 'Bride alone beneath the colonnade and lanterns of the Palais-Royal in Paris'],
  ['maries-rochers-mer-domaine-murtoli-corse-nathanael-charpentier.jpg', 'Newlyweds on the rocks facing the sea, Domaine de Murtoli in Corsica'],
  ['mariee-bassin-palmiers-marrakech-nathanael-charpentier.jpg', 'Bride beside a palm-lined pool, wedding in Marrakech'],
  ['voile-parc-chateau-pont-chevron-noir-et-blanc-nathanael-charpentier.jpg', 'Veil unfurled in the park of a Loire Valley château, black and white'],
  ['premiere-danse-chateau-la-bourdaisiere-nathanael-charpentier.jpg', 'First dance at the château de la Bourdaisière'],
  ['soiree-baiser-piste-chateau-saint-martin-du-tertre-nathanael-charpentier.jpg', 'A kiss on the dance floor late in the evening, French château wedding'],
  ['marie-porte-fete-jardins-coppelia-honfleur-nathanael-charpentier.jpg', 'The groom lifted by guests on the dance floor, Honfleur'],
].map(([f, a]) => ({ img: img(f), alt: a }));

const faq = [
  {
    q: 'Do you photograph weddings at Loire Valley châteaux?',
    r: 'Yes. Based in Gien, between the Sologne and the Loire Valley, an hour and a half from Paris, Nathanaël Charpentier photographs a limited number of château weddings each year — one wedding per weekend, documentary-first. Collections from €2,800.',
  },
  {
    q: 'How much does a destination wedding photographer in France cost?',
    r: 'Established destination wedding photographers in France charge €3,000–5,500; top-tier names €6,000 and above. Nathanaël Charpentier photographs weddings from €2,800, travel from the Loire Valley included within France.',
  },
  {
    q: 'Where have you photographed weddings?',
    r: 'In the Loire Valley and the Sologne, in Paris and Normandy, and abroad: Corsica, Andalusia, Brussels, Marrakech, Mauritius, the Seychelles and La Palmyre. Seven countries so far, and wherever he is invited.',
  },
  {
    q: 'Do you speak English?',
    r: 'Yes, enough to make your guests smile and your grandmother comfortable. Planning calls happen in English or French, as you prefer, and contracts are available in English.',
  },
];
---

<Base
  titre="Documentary wedding photographer in France — Loire Valley châteaux · Nathanaël Charpentier"
  description="Documentary wedding photography in France: your day exactly as it happened. Loire Valley châteaux, Paris, Normandy, Corsica. One wedding per weekend, from €2,800."
  lang="en"
  alterne="/mariage/"
  entete="sombre"
  partage="mariage"
  partageAlt="Guests circling the couple at sunset on the beach at La Palmyre"
>
  <Hero image={img(hero)} alt="Guests circling the couple at sunset on the beach at La Palmyre">
    <p class="label sur-image">Weddings</p>
    <h1>Nothing staged. Everything kept.</h1>
  </Hero>

  <section class="section">
    <div class="contenu recit mesure">
      <p class="apparait">
        I was a musician before I was a photographer, and I tend to compare a wedding day to a jazz
        set: written passages (the ceremony, the speeches) and everything that invents itself in
        between. The first look. A father’s trembling hand. What your mother will only say once.
        These moments have no second take.
      </p>
      <p class="apparait">
        I am not a double bass player, but that is the role I like best on those days: the one who
        connects melody and rhythm, invisible and yet essential. That is the place I look for in
        your day. In the quiet moments I am forgotten; when the party rises, I am inside it.
      </p>
      <p class="apparait">
        I do not stage your day, and I do not interrupt it for one more picture. I photograph
        continuously, with no real break: the small moments that seem unremarkable on the day are
        often the ones that matter most ten years later.
      </p>
      <p class="apparait">
        The studio comes with me. Guiding in a few words (a hand, a shoulder, where to rest your
        gaze) is a portraitist’s craft, and it travels to every wedding. Most couples are not at
        ease in front of a lens; a few cues at the right moment, and the handful of posed pictures
        are done quickly, before the day is handed back to you.
      </p>
      <p class="apparait">
        Your photographs may look like a magazine’s: I care about light, framing and the texture
        of an image. But above all they will look like you: your gestures, your people, your day as
        it actually happened.
      </p>
      <p class="apparait">
        I take on a limited number of weddings each year, one per weekend. I like to disappear
        entirely into a day and give it everything, usually from the morning preparations to the
        last dance. That is what makes this way of working possible.
      </p>
    </div>
  </section>

  <section class="section sombre">
    <div class="contenu">
      <Galerie photos={photos} />
    </div>
  </section>

  <Faq items={faq} titre="Before you write" />
  <Invitation lang="en" phrase="Your day is being planned somewhere. Write me the date, the place, what you picture." />
</Base>

<style>
  .sur-image { color: var(--ivoire); opacity: 0.8; }
  .recit { display: grid; gap: 1.9rem; }
</style>
