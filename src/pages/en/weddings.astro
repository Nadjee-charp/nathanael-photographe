---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Galerie from '../../components/Galerie.astro';
import Faq from '../../components/Faq.astro';
import Invitation from '../../components/Invitation.astro';

import heroImg from '../../assets/photos/mariage/mariee-couloir-clair-obscur-nathanael-charpentier.jpg';
import m01 from '../../assets/photos/mariage/preparatifs-mariage-larme-caftan-nathanael-charpentier.jpg';
import m04 from '../../assets/photos/mariage/mariage-rire-pere-mariee-nathanael-charpentier.jpg';
import m06 from '../../assets/photos/mariage/ceremonie-baiser-voile-vitraux-nathanael-charpentier.jpg';
import m08 from '../../assets/photos/mariage/mariage-chateau-grand-escalier-nathanael-charpentier.jpg';
import m09 from '../../assets/photos/mariage/mariage-chateau-double-escalier-nathanael-charpentier.jpg';
import m10 from '../../assets/photos/mariage/mariee-pensive-lumiere-doree-nathanael-charpentier.jpg';
import m12 from '../../assets/photos/mariage/couple-maries-vagues-ocean-nathanael-charpentier.jpg';
import m13 from '../../assets/photos/mariage/profil-mariee-couchant-nathanael-charpentier.jpg';
import m15 from '../../assets/photos/mariage/fete-rubans-soleil-couchant-nathanael-charpentier.jpg';
import m17 from '../../assets/photos/mariage/sortie-mariage-petales-chapeaux-nathanael-charpentier.jpg';
import m19 from '../../assets/photos/mariage/baiser-contre-jour-voile-nathanael-charpentier.jpg';

const photos = [
  { img: m01, alt: 'A tear wiped away during bridal preparations, golden caftan' },
  { img: m04, alt: 'Father and bride bursting into laughter together' },
  { img: m06, alt: 'A kiss under the veil in stained-glass light' },
  { img: m08, alt: 'Descending the grand château staircase towards the guests' },
  { img: m09, alt: 'Tiny couple at the foot of a symmetrical double staircase' },
  { img: m10, alt: 'Pensive bride in golden light' },
  { img: m12, alt: 'Newlyweds playing in the waves, black and white' },
  { img: m13, alt: 'Bride’s profile set ablaze by the setting sun' },
  { img: m15, alt: 'Ribbons dancing in the sunset during the party' },
  { img: m17, alt: 'Petals and knowing hats as the couple exits' },
  { img: m19, alt: 'Backlit kiss, veil flying' },
];

const faq = [
  {
    q: 'Do you photograph weddings at Loire Valley châteaux?',
    r: 'Yes. Based between Sologne and the Loire Valley, 1.5 hours from Paris, Nathanaël Charpentier photographs a limited number of château weddings each year, documentary-first. The great estates of the Loire are within an hour’s reach. Collections from €4,500.',
  },
  {
    q: 'How much does a destination wedding photographer in France cost?',
    r: 'Established destination wedding photographers in France charge €3,000–5,500; top-tier names €6,000–12,000+. Nathanaël Charpentier’s destination collections start at €4,500, including a pre-wedding conversation and a fine-art delivery.',
  },
  {
    q: 'Do you speak English?',
    r: 'Yes — enough to make your guests smile and your grandmother comfortable. Planning calls happen in English or French, as you prefer.',
  },
];
---

<Base
  titre="Documentary wedding photographer in France — Loire Valley châteaux · Nathanaël Charpentier"
  description="Documentary wedding photography in France: images that cannot be staged. Loire Valley châteaux, Paris, Corsica and beyond. Collections from €4,500."
  lang="en"
  alterne="/mariage/"
  entete="sombre"
>
  <Hero image={heroImg} alt="Bride lit in a chiaroscuro corridor">
    <p class="label" style="color: var(--ivoire); opacity: 0.8;">Weddings</p>
    <h1>Nothing staged. Everything kept.</h1>
  </Hero>

  <section class="section">
    <div class="contenu recit mesure">
      <p class="ouverture apparait">Your wedding is not <em class="italique">my solo.</em></p>
      <p class="apparait">
        A wedding works like a jazz set: written passages — the ceremony, the speeches — and
        everything that invents itself in between. The first look. A father’s trembling hand.
        What your mother will only say once. These moments have no second take: they are kept,
        or they are lost.
      </p>
      <p class="apparait">
        I work like a double bass player. You will barely hear me. In suspended moments I
        disappear; when the party rises I am inside it; and sometimes I stop playing altogether —
        some silences are not to be photographed, but respected.
      </p>
      <p class="apparait">
        Your photographs will not look like a magazine. They will look like you. That is a
        choice: magazine settings can be reproduced. Your day cannot.
      </p>
      <p class="apparait">
        I take on a limited number of weddings each year — not as a pose, but because this way
        of working cannot be done in series.
      </p>
    </div>
  </section>

  <section class="section sombre">
    <div class="contenu">
      <Galerie photos={photos} />
    </div>
  </section>

  <Faq items={faq} titre="Before you write" />
  <Invitation lang="en" phrase="If your day deserves to be kept exactly as it happened." />
</Base>

<style>
  .recit { display: grid; gap: 1.9rem; }
  .ouverture { font-size: clamp(1.5rem, 1.15rem + 1.6vw, 2.4rem); line-height: 1.3; }
  .ouverture em { color: var(--bronze); }
</style>
