---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import HeroDiaporama from '../../components/HeroDiaporama.astro';
import Faq from '../../components/Faq.astro';
import Invitation from '../../components/Invitation.astro';
import { Image } from 'astro:assets';
import { img, bandeau, HERO_ACCUEIL } from '../../lib/photos';

const photosHero = bandeau(HERO_ACCUEIL);
const portePortrait = 'portrait-noir-et-blanc-ombre-mur-studio-gien-nathanael-charpentier.jpg';
const porteMariage = 'mariee-colonnade-lanternes-palais-royal-paris-nathanael-charpentier.jpg';

const faq = [
  {
    q: 'Who is Nathanaël Charpentier?',
    r: 'A portrait photographer, Portraitiste de France 2021, co-founder of Studio NathSam in Gien, France, creator of the registered Portrait: Art & Âme approach and author of the talk “La Pudeur de l’Intrus”, on the photographer’s place inside other people’s intimacy. Co-founder and president of Collectif Carmin, the first French collective of birth photographers. A musician: saxophonist, guitarist, songwriter. Nearly twenty years in the craft, from wedding reportage to introspective portraiture.',
  },
  {
    q: 'Where does Nathanaël Charpentier work?',
    r: 'Based in Gien, between the Sologne and the châteaux of the Loire, an hour and a half from Paris. He photographs weddings and portraits in the Loire Valley, Paris and Normandy, and abroad: Corsica, Andalusia, Brussels, Marrakech, Mauritius and the Seychelles. Seven countries so far, and wherever he is invited.',
  },
  {
    q: 'In the age of AI, why hire a photographer for a portrait?',
    r: 'A generated image shows a possible face. A portrait that was lived keeps the trace of a real moment: exactly what no AI will produce. Nine people in ten want to know whether an image was generated by AI (Getty Images study). What gives a photograph its value is changing: no longer its perfection, but the certainty that it could not have been manufactured.',
  },
];
---

<Base
  titre="Nathanaël Charpentier — Portrait & wedding photographer · Loire Valley, France"
  description="Fine-art portraits and documentary wedding photography. Based in the Loire Valley, an hour and a half from Paris — travelling to Corsica, Marrakech, Mauritius and beyond."
  lang="en"
  alterne="/"
  partage="accueil"
  partageAlt="Photography by Nathanaël Charpentier"
>
  <HeroDiaporama photos={photosHero} duree={4}>
    <h1 class="hero-titre">Nathanaël Charpentier</h1>
    <p class="label hero-sous">Portrait &amp; wedding photographer — Loire Valley, France</p>
  </HeroDiaporama>

  <section class="section accroche">
    <div class="contenu centre">
      <p class="grande-phrase apparait">Some images cannot be taken.<br /><em>They are received.</em></p>
      <p class="mesure situe apparait">
        Nathanaël Charpentier photographs fine-art portraits and weddings the way a musician plays
        a jazz set: present enough to hold everything together, quiet enough to be forgotten. Based
        in Gien, between the Sologne and the châteaux of the Loire, an hour and a half from Paris,
        and wherever he is invited.
      </p>
    </div>
  </section>

  <section class="portes">
    <a class="porte vignette apparait" href={u('/en/portraits/')}>
      <Image src={img(portePortrait)} alt="Arm raised and shadow cast on the wall, black and white, Gien studio" widths={[500, 750, 1100, 1500, 1800]} sizes="(max-width: 720px) 100vw, 50vw" quality={88} loading="lazy" />
      <span class="porte-nom"><span class="porte-titre">Portraits</span></span>
    </a>
    <a class="porte vignette apparait" href={u('/en/weddings/')}>
      <Image src={img(porteMariage)} alt="Bride alone beneath the colonnade and lanterns of the Palais-Royal" widths={[500, 750, 1100, 1500, 1800]} sizes="(max-width: 720px) 100vw, 50vw" quality={88} loading="lazy" />
      <span class="porte-nom"><span class="porte-titre">Weddings</span></span>
    </a>
  </section>

  <section class="section sombre manifeste-extrait">
    <div class="contenu centre">
      <hr class="filet" />
      <p class="grande-phrase apparait">
        A photographer’s place is a privilege.<br /><em>I never take it for granted.</em>
      </p>
      <a class="lien label apparait" href={u('/en/about/')}>Read where I stand</a>
    </div>
  </section>

  <Faq items={faq} titre="Three questions" />

  <Invitation lang="en" />
</Base>

<style>
  .hero-titre { font-size: clamp(2.1rem, 1.5rem + 4.4vw, 5.8rem); letter-spacing: 0.04em; }
  .hero-sous { color: var(--ivoire); opacity: 0.85; margin-top: 0.8rem; }

  .centre { display: grid; justify-items: center; text-align: center; gap: 2.4rem; }
  .grande-phrase {
    font-size: clamp(1.6rem, 1.15rem + 2.4vw, 3.4rem);
    line-height: 1.25;
    max-width: 24ch;
    text-wrap: balance;
  }
  .grande-phrase em { font-style: italic; font-weight: 300; color: var(--bronze-texte); }
  .situe { font-size: 1.02rem; color: var(--pierre); max-width: 56ch; }

  .portes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    width: min(100% - 2 * var(--gouttiere), 78rem);
    margin-inline: auto;
  }
  .porte { position: relative; display: block; }
  /* Aucun format imposé : les deux images gardent le leur et rien n'est rogné. */
  .porte :global(img) { width: 100%; height: auto; display: block; }
  .porte-nom {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: clamp(1rem, 3vw, 1.6rem);
    color: var(--ivoire);
    background: linear-gradient(0deg, rgba(20, 19, 17, 0.55), transparent);
  }
  .porte-titre { font-family: var(--serif); font-size: clamp(1.4rem, 1.1rem + 1.8vw, 2.6rem); font-weight: 300; }

  @media (max-width: 720px) {
    .portes { grid-template-columns: 1fr; }
  }

  /* Sur téléphone, tout le texte de l'accueil est réduit d'un cinquième : le titre
     est posé sur la photo, et chaque point de moins en découvre davantage. */
  @media (max-width: 720px) {
    .hero-titre { font-size: calc(clamp(2.1rem, 1.5rem + 4.4vw, 5.8rem) * 0.8); }
    /* seule exception au -20 % : sous 10 px, ce libellé en capitales devient illisible */
    .hero-sous { font-size: max(0.625rem, calc(0.72rem * 0.8)); }
    .grande-phrase { font-size: calc(clamp(1.6rem, 1.15rem + 2.4vw, 3.4rem) * 0.8); }
    .situe { font-size: calc(1.02rem * 0.8); }
    .porte-titre { font-size: calc(clamp(1.4rem, 1.1rem + 1.8vw, 2.6rem) * 0.8); }
  }
</style>
