---
// [N-01] Page EN pre-wedding — vague 1. Hors navigation principale : accessible
// depuis le footer EN et liée depuis /en/weddings/ et /en/loire-valley-wedding-photographer/.
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import Galerie from '../../components/Galerie.astro';
import Faq from '../../components/Faq.astro';
import Invitation from '../../components/Invitation.astro';
import { img } from '../../lib/photos';

const photos = [
  ['mariee-colonnade-lanternes-palais-royal-paris-nathanael-charpentier.jpg', 'Bride alone beneath the colonnade and lanterns of the Palais-Royal, Paris'],
  ['baiser-balustrade-palais-royal-paris-nathanael-charpentier.jpg', 'A kiss on a golden balustrade under the arcades of the Palais-Royal'],
  ['mariee-chapeau-cape-balustrade-palais-royal-paris-nathanael-charpentier.jpg', 'Bride in a straw hat and silk cape leaning on a Palais-Royal balustrade'],
  ['etreinte-galerie-palais-royal-paris-nathanael-charpentier.jpg', 'Couple embracing in the gallery of the Palais-Royal, black and white'],
  ['mariee-profil-galerie-palais-royal-paris-nathanael-charpentier.jpg', 'Bride in profile in the gallery of the Palais-Royal, Paris'],
  ['baiser-balustrade-noir-et-blanc-palais-royal-paris-nathanael-charpentier.jpg', 'A kiss against a balustrade under the Palais-Royal arcades, black and white'],
  ['couple-arcades-louvre-paris-nathanael-charpentier.jpg', 'Couple under the arcades of the Louvre in Paris'],
  ['baiser-pavillon-colbert-louvre-paris-nathanael-charpentier.jpg', 'Couple in front of the Louvre’s Pavillon Colbert between two street lamps'],
  ['maries-pont-bir-hakeim-tour-eiffel-paris-nathanael-charpentier.jpg', 'Couple on the Bir-Hakeim bridge facing the Eiffel Tower, black and white'],
  ['maries-colonnade-pont-bir-hakeim-paris-nathanael-charpentier.jpg', 'Couple beneath the colonnade of the Bir-Hakeim bridge, Paris'],
  ['maries-tour-eiffel-colonnade-bir-hakeim-paris-nathanael-charpentier.jpg', 'Couple under the Bir-Hakeim colonnade, Eiffel Tower in the background'],
  ['mariee-fenetre-traine-chateau-champlatreux-nathanael-charpentier.jpg', 'Bride at a window, train spread across the parquet of a French château'],
].map(([f, a]) => ({ img: img(f), alt: a }));

const faq = [
  {
    q: 'Do you photograph pre-wedding sessions in the Loire Valley châteaux?',
    r: 'Yes. Nathanaël Charpentier is based in Gien, in the heart of the Loire Valley, and photographs pre-wedding sessions in the châteaux and parks between Sully-sur-Loire and Tours, as well as in Paris. He knows the estates, their owners and their best light — mornings are reserved before visitors arrive.',
  },
  {
    q: 'How much does a pre-wedding photoshoot in Paris or the Loire Valley cost?',
    r: 'A pre-wedding session with Nathanaël Charpentier starts at €1,200 for a half-day in one location, and €2,200 for a full day across Paris and the Loire Valley, with several outfits. All sessions include fine-art retouching and a preview gallery within 48 hours.',
  },
  {
    q: 'Can you work with Mandarin-speaking couples?',
    r: 'Yes. Sessions are conducted in English or French, and Mandarin-speaking assistance can be arranged for the day. Contracts are available in English, and the preview gallery is delivered in time to share on your favourite platforms before the end of your trip.',
  },
  {
    q: 'Is this a wedding? Do we need any paperwork?',
    r: 'No — a pre-wedding session is a photography session, not a civil ceremony, so no paperwork or residency is required. You simply bring the outfits you love; a symbolic vow ceremony can be arranged separately on request.',
  },
];
---

<Base
  titre="Pre-wedding photoshoot — Paris & Loire Valley châteaux · Nathanaël Charpentier"
  description="Pre-wedding photography sessions in Paris and the châteaux of the Loire Valley. Fine-art portraits by Nathanaël Charpentier, award-winning French photographer. Preview gallery within 48 hours."
  lang="en"
  entete="clair"
  partage="pre-wedding"
  partageAlt="A kiss on a golden balustrade under the arcades of the Palais-Royal in Paris"
>
  <section class="section entame">
    <div class="contenu">
      <p class="label apparait">Destination</p>
      <h1 class="apparait">Pre-wedding photography<br />Paris &amp; the Loire Valley</h1>

      <div class="mesure corps">
        <p class="apparait">
          Nathanaël Charpentier photographs pre-wedding sessions — also known as hunshazhao (婚纱照)
          — in Paris and in the châteaux of the Loire Valley, an hour and a half from the capital.
          A portrait photographer first (Portraitiste de France 2021), he brings to these sessions
          what he brings to every portrait: time, quiet guidance, and images made to last.
        </p>
        <p class="apparait">
          A pre-wedding session is a portrait of the two of you. Some moments are gently guided — a
          hand, a shoulder, where to rest your gaze. Others are simply kept as they happen, between
          two poses, when you forget the camera. Both belong in the final gallery; the second kind
          is usually the one you will frame.
        </p>
        <p class="apparait">
          Paris gives its light and its stone: the colonnades of the Palais-Royal, the bridges over
          the Seine at dawn, the gardens of the Louvre. The Loire Valley gives what no city can:
          châteaux with grand staircases and centuries-old parks, morning mist on the river, golden
          evening light — and the calm to enjoy it. Several outfits, several places, one coherent
          story.
        </p>
        <p class="apparait">
          A preview gallery is delivered within 48 hours — ready to share before you fly home.
        </p>
      </div>
    </div>
  </section>

  <section class="section sombre">
    <div class="contenu">
      <Galerie photos={photos} />
    </div>
  </section>

  <section class="section renvois">
    <div class="contenu mesure">
      <p class="apparait">
        See also <a class="lien" href={u('/en/weddings/')}>wedding photography</a> and
        <a class="lien" href={u('/en/loire-valley-wedding-photographer/')}>Loire Valley châteaux</a>.
      </p>
    </div>
  </section>

  <Faq items={faq} titre="Common questions" />
  <Invitation lang="en" phrase="Tell me your dates in France and what you have in mind." />
</Base>

<style>
  .entame { padding-top: clamp(7rem, 16vh, 11rem); }
  h1 { margin: 0.4rem 0 2.6rem; }
  .corps { display: grid; gap: 1.7rem; }
  .renvois { padding-block: clamp(3rem, 8vh, 5rem); color: var(--pierre); }
</style>
