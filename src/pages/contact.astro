---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SITE, FORMULAIRE } from '../lib/site';
import { estDemo } from '../lib/url';
import { img, alt } from '../lib/photos';
import Courriel from '../components/Courriel.astro';

const ecriture = 'ecriture-rai-lumiere-nathanael-charpentier.jpg';
// [T-05] GitHub Pages n'exécute pas de PHP : sur la démo le formulaire est désactivé
const action = FORMULAIRE.endpoint ?? u('/contact.php');
---

<Base
  titre="Contact · Nathanaël Charpentier, photographe · Gien, Val de Loire, Paris"
  description="Écrivez quelques lignes : qui vous êtes, ce que vous préparez, ce qui vous amène. Réponse personnelle sous 48 heures."
  lang="fr"
  alterne="/en/contact/"
  partage="contact"
  partageAlt={alt(ecriture)}
>
  <section class="section entame">
    <div class="contenu duo">
      <div class="texte">
        <p class="label apparait">Contact</p>
        <h1 class="apparait">Écrivez-moi<br />quelques lignes.</h1>
        <p class="apparait intro">
          Qui vous êtes, ce que vous préparez, ce qui vous amène. Je réponds personnellement,
          sous 48 heures. Si nous devons travailler ensemble, nous le saurons vite : ces choses-là
          s’entendent dès le premier échange.
        </p>

        {estDemo && !FORMULAIRE.endpoint && (
          <p class="note-demo">
            Aperçu de démonstration : le formulaire n’envoie pas encore de message.
            Écrivez directement à <Courriel />.
          </p>
        )}

        <form class="formulaire apparait" method="POST" action={action}>
          <div class="champ">
            <label for="nom">Votre nom</label>
            <input type="text" id="nom" name="nom" required autocomplete="name" />
          </div>
          <div class="champ">
            <label for="email">Votre adresse e-mail</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="champ">
            <label for="projet">Ce que vous préparez <span class="optionnel">(portrait, mariage, une date si vous l’avez)</span></label>
            <input type="text" id="projet" name="projet" />
          </div>
          <div class="champ">
            <label for="message">Quelques lignes</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>
          <input type="hidden" name="ouvert" value="" />
          <p class="piege" aria-hidden="true">
            <label for="site">Votre site</label>
            <input type="text" id="site" name="site" tabindex="-1" autocomplete="off" />
          </p>
          <button class="invitation" type="submit">Envoyer</button>
        </form>
        <p class="rgpd apparait">
          Ce que vous écrivez ici ne sert qu’à vous répondre : nom, adresse e-mail et message
          arrivent dans ma boîte, nulle part ailleurs. Rien n’est revendu, rien n’alimente une
          liste de diffusion. Je conserve les échanges trois ans, puis je les efface. Vous pouvez
          demander à voir, corriger ou supprimer ce que j’ai gardé, en écrivant à la même adresse.
        </p>

        <p class="direct apparait">
          Ou directement : <Courriel />
          &nbsp;·&nbsp; <a class="lien" href={`tel:${SITE.telephone.replace(/\s/g, '')}`}>{SITE.telephone}</a><br />
          <span class="adresse">{SITE.adresse.rue}, {SITE.adresse.codePostal} {SITE.adresse.ville}, sur rendez-vous</span>
        </p>
      </div>
      <div class="image apparait">
        <Image
          src={img(ecriture)}
          alt={alt(ecriture)}
          widths={[500, 750, 1100, 1500, 1800]}
          sizes="(max-width: 900px) 100vw, 40vw"
          quality={88}
          loading="eager"
        />
      </div>
    </div>
  </section>
</Base>

<script>
  // [N2-02] Horodatage d'ouverture : le serveur rejette ce qui revient en moins de
  // trois secondes. Un visiteur ne remplit jamais un formulaire aussi vite, un robot si.
  for (const f of document.querySelectorAll('form.formulaire')) {
    const champ = f.querySelector('input[name="ouvert"]');
    if (champ) champ.value = String(Date.now());
  }
</script>

<style>
  .entame { padding-top: clamp(3rem, 7vh, 4.5rem); }

  .duo {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  h1 { margin: 0.4rem 0 1.6rem; }

  .intro { max-width: 52ch; margin-bottom: 3rem; }

  .note-demo {
    max-width: 48ch;
    margin-bottom: 2.2rem;
    padding: 1rem 1.2rem;
    border-left: 2px solid var(--bronze);
    background: color-mix(in srgb, var(--bronze) 7%, transparent);
    font-size: 0.94rem;
    color: var(--pierre);
  }

  .formulaire { display: grid; gap: 1.7rem; max-width: 36rem; }

  .champ { display: grid; gap: 0.5rem; }

  label {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pierre);
  }
  .optionnel { text-transform: none; letter-spacing: 0.04em; }

  input, textarea {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--encre);
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--encre) 30%, transparent);
    padding: 0.55em 0;
    border-radius: 0;
    transition: border-color var(--moyen) var(--courbe);
  }
  input:focus, textarea:focus {
    outline: none;
    border-bottom-color: var(--bronze);
  }
  textarea { resize: vertical; line-height: 1.6; }

  .piege { position: absolute; left: -200vw; }

  button.invitation {
    background: transparent;
    color: var(--encre);
    cursor: pointer;
    justify-self: start;
    margin-top: 0.6rem;
  }


  .rgpd {
    margin-top: 1.6rem;
    max-width: 52ch;
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--pierre);
  }
  .direct { margin-top: 3rem; font-size: 0.98rem; }
  .adresse { color: var(--pierre); font-size: 0.9rem; }

  .image :global(img) { width: 100%; }

  @media (max-width: 900px) {
    .duo { grid-template-columns: 1fr; }
    .image { order: -1; max-width: 26rem; }
  }
</style>
