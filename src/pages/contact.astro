---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SITE } from '../lib/site';

import ecriture from '../assets/photos/details/ecriture-rai-lumiere-nathanael-charpentier.jpg';
---

<Base
  titre="Contact · Nathanaël Charpentier, photographe — Gien, Val de Loire, Paris"
  description="Écrivez quelques lignes : qui vous êtes, ce que vous préparez, ce qui vous amène. Réponse personnelle sous 48 heures."
  lang="fr"
  alterne="/en/contact/"
  entete="clair"
>
  <section class="section entame">
    <div class="contenu duo">
      <div class="texte">
        <p class="label apparait">Contact</p>
        <h1 class="apparait">Écrivez-moi<br />quelques lignes.</h1>
        <p class="apparait intro">
          Qui vous êtes, ce que vous préparez, ce qui vous amène. Je réponds personnellement,
          sous 48 heures. Si nous devons travailler ensemble, nous le saurons vite — ces choses-là
          s’entendent dès le premier échange.
        </p>

        <form class="formulaire apparait" method="POST" action={u('/contact.php')}>
          <div class="champ">
            <label for="nom">Votre nom</label>
            <input type="text" id="nom" name="nom" required autocomplete="name" />
          </div>
          <div class="champ">
            <label for="email">Votre adresse e-mail</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="champ">
            <label for="projet">Ce que vous préparez <span class="optionnel">— portrait, mariage, une date si vous l’avez</span></label>
            <input type="text" id="projet" name="projet" />
          </div>
          <div class="champ">
            <label for="message">Quelques lignes</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>
          <p class="piege" aria-hidden="true">
            <label for="site">Votre site</label>
            <input type="text" id="site" name="site" tabindex="-1" autocomplete="off" />
          </p>
          <button class="invitation" type="submit">Envoyer</button>
        </form>

        <p class="direct apparait">
          Ou directement : <a class="lien" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          &nbsp;·&nbsp; <a class="lien" href={`tel:${SITE.telephone.replace(/\s/g, '')}`}>{SITE.telephone}</a><br />
          <span class="adresse">{SITE.adresse.rue}, {SITE.adresse.codePostal} {SITE.adresse.ville} — sur rendez-vous</span>
        </p>
      </div>
      <div class="image apparait">
        <Image
          src={ecriture}
          alt="Main écrivant dans un rai de lumière"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 40vw"
          quality={82}
          loading="eager"
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .entame { padding-top: clamp(8rem, 16vh, 11rem); }

  .duo {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  h1 { margin: 0.4rem 0 1.6rem; }

  .intro { max-width: 52ch; margin-bottom: 3rem; }

  .formulaire { display: grid; gap: 1.7rem; max-width: 36rem; }

  .champ { display: grid; gap: 0.5rem; }

  label {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pierre);
  }
  .optionnel { text-transform: none; letter-spacing: 0.04em; }

  input, textarea {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--encre);
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--encre) 30%, transparent);
    padding: 0.55em 0;
    border-radius: 0;
    transition: border-color var(--moyen) var(--courbe);
  }
  input:focus, textarea:focus {
    outline: none;
    border-bottom-color: var(--bronze);
  }
  textarea { resize: vertical; line-height: 1.6; }

  .piege { position: absolute; left: -200vw; }

  button.invitation {
    background: transparent;
    color: var(--encre);
    cursor: pointer;
    justify-self: start;
    margin-top: 0.6rem;
  }

  .direct { margin-top: 3rem; font-size: 0.98rem; }
  .adresse { color: var(--pierre); font-size: 0.9rem; }

  .image :global(img) { width: 100%; }

  @media (max-width: 900px) {
    .duo { grid-template-columns: 1fr; }
    .image { order: -1; max-width: 26rem; }
  }
</style>
