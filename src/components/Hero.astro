---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** hauteur : 'plein' = 100svh (accueil), 'grand' = 82svh */
  hauteur?: 'plein' | 'grand';
}
const { image, alt, hauteur = 'grand' } = Astro.props;
---

<section class:list={['hero', hauteur]}>
  <Image
    src={image}
    alt={alt}
    widths={[720, 1280, 1920, 2560]}
    sizes="100vw"
    quality={78}
    loading="eager"
    fetchpriority="high"
    class="hero-img"
  />
  <div class="hero-voile" aria-hidden="true"></div>
  <div class="contenu hero-texte">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--encre);
    color: var(--ivoire);
  }
  .hero.plein { min-height: 100svh; }
  .hero.grand { min-height: 82svh; }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-voile {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 19, 17, 0.38) 0%, rgba(20, 19, 17, 0) 26%),
      linear-gradient(0deg, rgba(20, 19, 17, 0.52) 0%, rgba(20, 19, 17, 0) 44%);
  }

  .hero-texte {
    position: relative;
    padding-block: clamp(2.5rem, 7vh, 5rem);
  }
</style>
