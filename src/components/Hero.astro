---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** hauteur du bandeau : 'grand' pour une ouverture de rubrique, 'plein' un cran au-dessus */
  hauteur?: 'plein' | 'grand';
  /** point d'ancrage du recadrage — utile quand le sujet n'est pas centré */
  ancrage?: string;
}
const { image, alt, hauteur = 'grand', ancrage = 'center 35%' } = Astro.props;
---

<section class:list={['hero', hauteur]}>
  <Image
    src={image}
    alt={alt}
    widths={[750, 1100, 1500, 1920, 2560, 3840]}
    sizes="100vw"
    quality={86}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="hero-img"
    style={`object-position: ${ancrage};`}
  />
  <div class="hero-voile" aria-hidden="true"></div>
  <div class="contenu hero-texte">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--encre);
    color: var(--ivoire);
  }
  /* Un bandeau borné, jamais le plein écran : la page doit s'annoncer sous l'image. */
  .hero.plein { height: clamp(28rem, 78svh, 50rem); }
  .hero.grand { height: clamp(26rem, 70svh, 44rem); }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-voile {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 19, 17, 0.38) 0%, rgba(20, 19, 17, 0) 26%),
      linear-gradient(0deg, rgba(20, 19, 17, 0.52) 0%, rgba(20, 19, 17, 0) 44%);
  }

  .hero-texte {
    position: relative;
    padding-block: clamp(2.5rem, 7vh, 5rem);
  }

  @media (max-width: 720px) {
    /* un peu moins haut : on voit que la page continue sous le pli */
    .hero.plein { height: clamp(22rem, 62svh, 32rem); }
    .hero.grand { height: clamp(20rem, 56svh, 29rem); }

    /* le dégradé du bas est renforcé : le texte reste lisible sur une photo claire */
    .hero-voile {
      background:
        linear-gradient(180deg, rgba(20, 19, 17, 0.45) 0%, rgba(20, 19, 17, 0) 30%),
        linear-gradient(0deg, rgba(20, 19, 17, 0.68) 0%, rgba(20, 19, 17, 0) 52%);
    }
  }
</style>
