---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** hauteur : 'plein' = plein écran (accueil), 'grand' = 82svh */
  hauteur?: 'plein' | 'grand';
  /** point d'ancrage du recadrage — utile quand le sujet n'est pas centré */
  ancrage?: string;
}
const { image, alt, hauteur = 'grand', ancrage = 'center' } = Astro.props;
---

<section class:list={['hero', hauteur]}>
  <Image
    src={image}
    alt={alt}
    widths={[640, 960, 1400, 1920, 2400]}
    sizes="100vw"
    quality={74}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="hero-img"
    style={`object-position: ${ancrage};`}
  />
  <div class="hero-voile" aria-hidden="true"></div>
  <div class="contenu hero-texte">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--encre);
    color: var(--ivoire);
  }
  .hero.plein { min-height: 100svh; }
  .hero.grand { min-height: 82svh; }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-voile {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 19, 17, 0.38) 0%, rgba(20, 19, 17, 0) 26%),
      linear-gradient(0deg, rgba(20, 19, 17, 0.52) 0%, rgba(20, 19, 17, 0) 44%);
  }

  .hero-texte {
    position: relative;
    padding-block: clamp(2.5rem, 7vh, 5rem);
  }

  @media (max-width: 720px) {
    /* un peu moins haut : on voit que la page continue sous le pli */
    .hero.plein { min-height: 88svh; }
    .hero.grand { min-height: 66svh; }

    /* le dégradé du bas est renforcé : le texte reste lisible sur une photo claire */
    .hero-voile {
      background:
        linear-gradient(180deg, rgba(20, 19, 17, 0.45) 0%, rgba(20, 19, 17, 0) 30%),
        linear-gradient(0deg, rgba(20, 19, 17, 0.68) 0%, rgba(20, 19, 17, 0) 52%);
    }
  }
</style>
