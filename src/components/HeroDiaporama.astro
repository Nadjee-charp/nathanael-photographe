---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Vue {
  img: ImageMetadata;
  alt: string;
}
interface Props {
  photos: Vue[];
  /** durée d'affichage de chaque photo, en secondes */
  duree?: number;
}
const { photos, duree = 4 } = Astro.props;
---

<section class="hero diaporama" data-duree={duree}>
  <div class="scene">
    {photos.map((p, i) => (
      <div class:list={['couche', { active: i === 0 }]} data-index={i}>
        <Image
          src={p.img}
          alt={p.alt}
          widths={[750, 1100, 1500, 1920, 2560]}
          sizes="100vw"
          quality={88}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
        />
      </div>
    ))}
  </div>

  <div class="contenu hero-texte">
    <slot />
  </div>
</section>

<style>
  .hero {
    background: var(--encre);
    color: var(--ivoire);
    padding-bottom: clamp(1.4rem, 4vh, 2.6rem);
  }

  /* Le cadrage d'une photographie appartient au photographe : aucune image n'est
     rognée ici. La scène fixe seulement une hauteur commune ; chaque photo s'y
     inscrit entière, avec ses proportions d'origine, et reste donc visible de haut
     en bas quel que soit son format. La hauteur est bornée par la fenêtre et par la
     largeur, pour qu'un bandeau ne dévore jamais l'écran. */
  .scene {
    position: relative;
    width: 100%;
    height: min(52svh, 70vw, 32rem);
  }

  .couche {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1400ms var(--courbe);
  }
  .couche.active { opacity: 1; }

  .couche :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Sans JavaScript, la première photo reste visible. */
  :global(html:not(.js)) .couche[data-index='0'] { opacity: 1; }

  /* Le titre est posé sous l'image, sur le fond du bloc : plus aucun texte ne vient
     se coucher en travers d'une photo ni du fond qui l'entoure. */
  .hero-texte {
    position: relative;
    padding-top: clamp(1rem, 3vh, 1.8rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .couche { transition: none; }
  }
</style>

<script>
  (() => {
    for (const bloc of document.querySelectorAll('.diaporama')) {
      const photos = [...bloc.querySelectorAll('.couche')];
      const duree = (Number(bloc.dataset.duree) || 4) * 1000;
      if (photos.length < 2) continue;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

      let index = 0;
      let minuteur = null;

      const suivante = () => {
        index = (index + 1) % photos.length;
        photos.forEach((c, i) => c.classList.toggle('active', i === index));
        minuteur = setTimeout(suivante, duree);
      };

      minuteur = setTimeout(suivante, duree);

      // Onglet en arrière-plan : inutile de faire tourner la boucle.
      document.addEventListener('visibilitychange', () => {
        clearTimeout(minuteur);
        if (!document.hidden) minuteur = setTimeout(suivante, duree);
      });
    }
  })();
</script>
