---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Vue {
  img: ImageMetadata;
  alt: string;
}
interface Props {
  photos: Vue[];
  /** durée d'affichage de chaque photo, en secondes */
  duree?: number;
}
const { photos, duree = 4 } = Astro.props;
---

<section class="hero diaporama" data-duree={duree}>
  <div class="scene">
    {photos.map((p, i) => (
      <div class:list={['couche', { active: i === 0 }]} data-index={i}>
        <Image
          src={p.img}
          alt={p.alt}
          widths={[750, 1100, 1500, 1920, 2560]}
          sizes="100vw"
          quality={88}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
        />
      </div>
    ))}
  </div>

  <div class="hero-voile" aria-hidden="true"></div>
  <div class="contenu hero-texte">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    background: var(--encre);
    color: var(--ivoire);
  }

  /* Toutes les images du bandeau ont été préparées au même format 3:2 : la scène
     adopte ce format, `cover` tombe donc juste au pixel près. Aucune image n'est
     rognée, aucune n'est plus petite qu'une autre, et il n'y a rien sur les bords. */
  .scene {
    position: relative;
    grid-area: 1 / 1;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .couche {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1400ms var(--courbe);
  }
  .couche.active { opacity: 1; }

  .couche :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Sans JavaScript, la première photo reste visible. */
  :global(html:not(.js)) .couche[data-index='0'] { opacity: 1; }

  .hero-voile {
    grid-area: 1 / 1;
    align-self: end;
    height: 48%;
    background: linear-gradient(0deg, rgba(20, 19, 17, 0.8) 0%, rgba(20, 19, 17, 0) 100%);
    pointer-events: none;
  }

  .hero-texte {
    grid-area: 1 / 1;
    align-self: end;
    position: relative;
    padding-block: clamp(1.4rem, 4vh, 3.2rem);
  }

  @media (max-width: 720px) {
    .hero-voile { height: 62%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .couche { transition: none; }
  }
</style>

<script>
  (() => {
    for (const bloc of document.querySelectorAll('.diaporama')) {
      const photos = [...bloc.querySelectorAll('.couche')];
      const duree = (Number(bloc.dataset.duree) || 4) * 1000;
      if (photos.length < 2) continue;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

      let index = 0;
      let minuteur = null;

      const suivante = () => {
        index = (index + 1) % photos.length;
        photos.forEach((c, i) => c.classList.toggle('active', i === index));
        minuteur = setTimeout(suivante, duree);
      };

      minuteur = setTimeout(suivante, duree);

      // Onglet en arrière-plan : inutile de faire tourner la boucle.
      document.addEventListener('visibilitychange', () => {
        clearTimeout(minuteur);
        if (!document.hidden) minuteur = setTimeout(suivante, duree);
      });
    }
  })();
</script>
