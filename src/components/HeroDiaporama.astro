---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Vue {
  img: ImageMetadata;
  alt: string;
}
interface Props {
  photos: Vue[];
  /** durée d'affichage de chaque photo, en secondes */
  duree?: number;
}
const { photos, duree = 4 } = Astro.props;
---

<section class="hero diaporama" data-duree={duree}>
  <div class="scene">
    {photos.map((p, i) => (
      <div class:list={['couche', { active: i === 0 }]} data-index={i}>
        {/* Prolongement flouté de la photo, qui remplit ce que ses proportions
            laissent libre sur les côtés. Petite définition : elle est floue. */}
        <Image
          class="fond"
          src={p.img}
          alt=""
          widths={[900]}
          sizes="900px"
          quality={55}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          aria-hidden="true"
        />
        <Image
          class="net"
          src={p.img}
          alt={p.alt}
          widths={[750, 1100, 1500, 1920, 2560]}
          sizes="100vw"
          quality={88}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
        />
      </div>
    ))}
  </div>

  <div class="hero-voile" aria-hidden="true"></div>
  <div class="contenu hero-texte">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    background: var(--encre);
    color: var(--ivoire);
  }

  /* Le cadrage d'une photographie appartient au photographe : aucune image n'est
     rognée. La scène occupe 95 % de la hauteur utile de la fenêtre (hors barre de
     navigation) : on arrive dans l'image, sans avoir à faire défiler pour la voir
     en entier. Chaque photo s'y inscrit complète, et toutes ont donc exactement la
     même hauteur. Sur un écran étroit c'est la largeur qui borne, sinon une photo
     paysage laisserait trop de vide au-dessus et en dessous. */
  .scene {
    position: relative;
    grid-area: 1 / 1;
    width: 100%;
    height: min(calc((100svh - var(--entete)) * 0.95), 80vw);
    overflow: hidden;
  }

  .couche {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1400ms var(--courbe);
  }
  .couche.active { opacity: 1; }

  .couche :global(.fond) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* l'agrandissement évite que le flou laisse apparaître un liseré sur les bords */
    transform: scale(1.15);
    filter: blur(42px) brightness(0.5) saturate(0.75);
  }

  .couche :global(.net) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Sans JavaScript, la première photo reste visible. */
  :global(html:not(.js)) .couche[data-index='0'] { opacity: 1; }

  .hero-voile {
    grid-area: 1 / 1;
    align-self: end;
    height: 40%;
    background: linear-gradient(0deg, rgba(20, 19, 17, 0.72) 0%, rgba(20, 19, 17, 0) 100%);
    pointer-events: none;
  }

  .hero-texte {
    grid-area: 1 / 1;
    align-self: end;
    position: relative;
    padding-block: clamp(1.2rem, 3.5vh, 2.6rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .couche { transition: none; }
  }
</style>

<script>
  (() => {
    for (const bloc of document.querySelectorAll('.diaporama')) {
      const photos = [...bloc.querySelectorAll('.couche')];
      const duree = (Number(bloc.dataset.duree) || 4) * 1000;
      if (photos.length < 2) continue;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

      let index = 0;
      let minuteur = null;

      const suivante = () => {
        index = (index + 1) % photos.length;
        photos.forEach((c, i) => c.classList.toggle('active', i === index));
        minuteur = setTimeout(suivante, duree);
      };

      minuteur = setTimeout(suivante, duree);

      // Onglet en arrière-plan : inutile de faire tourner la boucle.
      document.addEventListener('visibilitychange', () => {
        clearTimeout(minuteur);
        if (!document.hidden) minuteur = setTimeout(suivante, duree);
      });
    }
  })();
</script>
