---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Vue {
  img: ImageMetadata;
  alt: string;
  /** cadrage propre à cette image, quand le sujet n'est pas là où on l'attend */
  ancrage?: string;
}
interface Props {
  photos: Vue[];
  /** durée d'affichage de chaque photo, en secondes */
  duree?: number;
  /**
   * Point d'ancrage par défaut. Le bandeau remplit toute sa surface : sur une image
   * plus haute que le bandeau, c'est ce point qui décide de ce qu'on garde.
   * Le tiers supérieur convient à la plupart des cadrages ; les images dont le sujet
   * touche le bord haut portent leur propre ancrage.
   */
  ancrage?: string;
}
const { photos, duree = 5, ancrage = 'center 35%' } = Astro.props;
---

<section class="hero diaporama" data-duree={duree}>
  <div class="scene" style={`--ancrage: ${ancrage}`}>
    {photos.map((p, i) => (
      <div class:list={['couche', { active: i === 0 }]} data-index={i}>
        <Image
          src={p.img}
          alt={p.alt}
          widths={[750, 1100, 1500, 1920, 2560, 3200]}
          sizes="100vw"
          quality={86}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
          style={p.ancrage ? `object-position: ${p.ancrage}` : undefined}
        />
      </div>
    ))}
  </div>

  <div class="hero-voile" aria-hidden="true"></div>
  <div class="contenu hero-texte">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    background: var(--encre);
    color: var(--ivoire);
  }

  /* Un bandeau, pas un plein écran : il reste toujours un aperçu de la page en dessous.
     La hauteur est bornée pour que le cadrage ne devienne jamais une meurtrière. */
  .scene {
    position: relative;
    grid-area: 1 / 1;
    width: 100%;
    height: clamp(26rem, 74svh, 46rem);
    overflow: hidden;
  }

  .couche {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1400ms var(--courbe);
  }
  .couche.active { opacity: 1; }

  /* `cover` : l'image remplit le bandeau, aucun liseré ne se voit sur les bords. */
  .couche :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ancrage, center 35%);
    display: block;
  }

  /* Sans JavaScript, la première photo reste visible. */
  :global(html:not(.js)) .couche[data-index='0'] { opacity: 1; }

  .hero-voile {
    grid-area: 1 / 1;
    align-self: end;
    height: 55%;
    background: linear-gradient(0deg, rgba(20, 19, 17, 0.78) 0%, rgba(20, 19, 17, 0) 100%);
    pointer-events: none;
  }

  .hero-texte {
    grid-area: 1 / 1;
    align-self: end;
    position: relative;
    padding-block: clamp(1.6rem, 5vh, 3.4rem);
  }

  @media (max-width: 720px) {
    .scene { height: clamp(21rem, 58svh, 30rem); }
    .hero-voile { height: 62%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .couche { transition: none; }
  }
</style>

<script>
  (() => {
    for (const bloc of document.querySelectorAll('.diaporama')) {
      const photos = [...bloc.querySelectorAll('.couche')];
      const duree = (Number(bloc.dataset.duree) || 5) * 1000;
      if (photos.length < 2) continue;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

      let index = 0;
      let minuteur = null;

      const suivante = () => {
        index = (index + 1) % photos.length;
        photos.forEach((c, i) => c.classList.toggle('active', i === index));
        minuteur = setTimeout(suivante, duree);
      };

      minuteur = setTimeout(suivante, duree);

      // Onglet en arrière-plan : inutile de faire tourner la boucle.
      document.addEventListener('visibilitychange', () => {
        clearTimeout(minuteur);
        if (!document.hidden) minuteur = setTimeout(suivante, duree);
      });
    }
  })();
</script>
