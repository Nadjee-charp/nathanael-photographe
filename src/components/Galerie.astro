---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Photo {
  img: ImageMetadata;
  alt: string;
  legende?: string;
}
interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;

// Rythme éditorial : les paysages occupent la pleine largeur,
// les portraits se répondent deux à deux (à la Beutler).
type Rangee = { type: 'pleine' | 'duo' | 'solo'; items: Photo[] };
const rangees: Rangee[] = [];
let attente: Photo | null = null;
for (const p of photos) {
  const paysage = p.img.width >= p.img.height;
  if (paysage) {
    if (attente) {
      rangees.push({ type: 'solo', items: [attente] });
      attente = null;
    }
    rangees.push({ type: 'pleine', items: [p] });
  } else if (attente) {
    rangees.push({ type: 'duo', items: [attente, p] });
    attente = null;
  } else {
    attente = p;
  }
}
if (attente) rangees.push({ type: 'solo', items: [attente] });
---

<div class="galerie">
  {rangees.map((r) => (
    <figure class:list={['rangee', r.type, 'apparait']}>
      {r.items.map((p) => (
        <div class="cadre">
          <Image
            src={p.img}
            alt={p.alt}
            widths={r.type === 'pleine' ? [750, 1100, 1500, 1920, 2560] : [500, 750, 1100, 1500, 1800]}
            sizes={
              r.type === 'pleine'
                ? '(max-width: 720px) 100vw, (max-width: 78rem) 100vw, 78rem'
                : '(max-width: 720px) 100vw, (max-width: 78rem) 46vw, 36rem'
            }
            quality={88}
            loading="lazy"
            decoding="async"
          />
          {p.legende && <figcaption class="label">{p.legende}</figcaption>}
        </div>
      ))}
    </figure>
  ))}
</div>

<style>
  .galerie {
    display: grid;
    gap: clamp(2rem, 5vh, 3.5rem);
  }

  .rangee {
    margin: 0;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .rangee.duo { grid-template-columns: 1fr 1fr; }
  .rangee.duo .cadre:nth-child(2) { transform: translateY(clamp(1.5rem, 4vh, 3rem)); }

  .rangee.solo { justify-items: center; }
  .rangee.solo .cadre { max-width: min(34rem, 88%); }

  .cadre :global(img) { width: 100%; height: auto; }

  /* Les paysages sont recadrés seulement sur grand écran, jamais sur mobile */
  .rangee.pleine :global(img) { max-height: 88vh; object-fit: cover; }

  figcaption {
    margin-top: 0.7rem;
    font-size: 0.66rem;
  }

  /* ————— Mobile : les photos vont d'un bord à l'autre et ne sont jamais rognées ————— */
  @media (max-width: 720px) {
    .galerie { gap: 1.6rem; }

    .rangee { gap: 1.6rem; }
    .rangee.duo { grid-template-columns: 1fr; }
    .rangee.duo .cadre:nth-child(2) { transform: none; }
    /* max-width: none — sinon la contrainte annule la pleine largeur ci-dessous */
    .rangee.solo { justify-items: stretch; }
    .rangee.solo .cadre { max-width: none; }

    /* on sort de la gouttière du conteneur : image pleine largeur d'écran */
    .cadre {
      margin-inline: calc(-1 * var(--gouttiere));
      width: calc(100% + 2 * var(--gouttiere));
    }

    /* aucune coupe : on voit la photo entière */
    .rangee.pleine :global(img) {
      max-height: none;
      object-fit: contain;
    }

    figcaption { padding-inline: var(--gouttiere); }
  }
</style>
