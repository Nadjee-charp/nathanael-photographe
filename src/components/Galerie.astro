---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Photo {
  img: ImageMetadata;
  alt: string;
  legende?: string;
}
interface Props {
  photos: Photo[];
  /** fond sombre (les images flottent sur l'encre) */
  fond?: 'sombre' | 'clair';
}
const { photos } = Astro.props;

// Rythme éditorial : les paysages occupent la pleine largeur,
// les portraits se répondent deux à deux (à la Beutler).
type Rangee = { type: 'pleine'; items: Photo[] } | { type: 'duo'; items: Photo[] } | { type: 'solo'; items: Photo[] };
const rangees: Rangee[] = [];
let attente: Photo | null = null;
for (const p of photos) {
  const paysage = p.img.width >= p.img.height;
  if (paysage) {
    if (attente) { rangees.push({ type: 'solo', items: [attente] }); attente = null; }
    rangees.push({ type: 'pleine', items: [p] });
  } else if (attente) {
    rangees.push({ type: 'duo', items: [attente, p] });
    attente = null;
  } else {
    attente = p;
  }
}
if (attente) rangees.push({ type: 'solo', items: [attente] });
---

<div class="galerie">
  {rangees.map((r) => (
    <figure class:list={['rangee', r.type, 'apparait']}>
      {r.items.map((p) => (
        <div class="cadre">
          <Image
            src={p.img}
            alt={p.alt}
            widths={r.type === 'pleine' ? [720, 1280, 1920, 2400] : [480, 800, 1200]}
            sizes={r.type === 'pleine' ? '(max-width: 78rem) 100vw, 78rem' : '(max-width: 640px) 100vw, 38rem'}
            quality={80}
            loading="lazy"
          />
          {p.legende && <figcaption class="label">{p.legende}</figcaption>}
        </div>
      ))}
    </figure>
  ))}
</div>

<style>
  .galerie {
    display: grid;
    gap: clamp(1.5rem, 4vh, 3.5rem);
  }

  .rangee {
    margin: 0;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .rangee.duo { grid-template-columns: 1fr 1fr; }

  .rangee.duo .cadre:nth-child(2) { transform: translateY(clamp(1.5rem, 4vh, 3rem)); }

  .rangee.solo { justify-items: center; }
  .rangee.solo .cadre { max-width: min(34rem, 88%); }

  .rangee.pleine :global(img) {
    width: 100%;
    max-height: 88vh;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.7rem;
    font-size: 0.66rem;
  }

  @media (max-width: 640px) {
    .rangee.duo { grid-template-columns: 1fr; }
    .rangee.duo .cadre:nth-child(2) { transform: none; }
    .rangee.solo .cadre { max-width: 100%; }
  }
</style>
