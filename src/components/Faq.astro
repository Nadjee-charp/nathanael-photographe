---
// FAQ repliée — structure « réponse d'abord » (GEO) + schema.org FAQPage.
// Accordéon natif <details> : crawlable, zéro JavaScript.
interface Item {
  q: string;
  r: string; // texte brut (le tiret long sépare réponse extractible / développement)
}
interface Props {
  items: Item[];
  titre?: string;
}
const { items, titre = 'Questions' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.r },
  })),
};
---

<section class="faq contenu mesure">
  <p class="label">{titre}</p>
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p>{i.r}</p>
    </details>
  ))}
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .faq {
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  details {
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    padding-block: 1.1rem;
  }
  details:last-of-type {
    border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    font-size: 1.05em;
    font-weight: 400;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+';
    font-family: var(--sans);
    font-weight: 300;
    color: var(--bronze);
    transition: transform var(--moyen) var(--courbe);
  }
  details[open] summary::after { transform: rotate(45deg); }

  details p {
    margin-top: 0.9rem;
    font-size: 0.94em;
    color: color-mix(in srgb, currentColor 82%, transparent);
    max-width: 58ch;
  }

  .label { margin-bottom: 1.6rem; }
</style>
