---
/**
 * [N2-09] [N2-14] Citations clients.
 *
 * Règles de la note n°2 : italique, prénom seul ou signature, mention « avis Google »,
 * sans étoiles, sans note chiffrée, sans date, sans carrousel. Aucun balisage Review
 * ni aggregateRating en JSON-LD : un avis auto-déclaré est contraire aux consignes
 * Google. Ici, du texte, rien de plus.
 *
 * Les coupes internes gardent leur […] : on ne comble pas un avis.
 */
export interface Mot {
  /** la citation, verbatim */
  texte: string;
  /** qui parle, et à quel titre */
  signature: string;
}
interface Props {
  titre?: string;
  mots: Mot[];
}
const { titre = 'Leurs mots', mots } = Astro.props;
---

<section class="section leurs-mots">
  <div class="contenu">
    <p class="label apparait">{titre}</p>
    <div class="paroles">
      {mots.map((m) => (
        <figure class="apparait">
          <blockquote>{m.texte}</blockquote>
          <figcaption>{m.signature}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .leurs-mots { padding-block: clamp(3.5rem, 9vh, 6rem); }

  .paroles {
    margin-top: 2rem;
    display: grid;
    gap: clamp(2rem, 5vh, 3.2rem);
    max-width: 62rem;
  }

  figure { margin: 0; }

  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.45;
    max-width: 46ch;
  }

  figcaption {
    margin-top: 0.8rem;
    font-family: var(--sans);
    font-weight: 300;
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    color: var(--pierre);
  }

  /* sur fond sombre, le gris de pierre devient illisible */
  :global(.sombre) .leurs-mots figcaption { color: var(--pierre-claire); }
</style>
