---
import { u } from '../lib/url';
import { SITE, type Locale } from '../lib/site';

interface Props { lang?: Locale }
const { lang = 'fr' } = Astro.props;
const annee = new Date().getFullYear();
const fr = lang === 'fr';
---

<footer class="pied sombre">
  <div class="contenu">
    <div class="colonnes">
      <div>
        <p class="label">{fr ? 'Explorer' : 'Explore'}</p>
        <ul>
          {fr ? (
            <>
              <li><a class="lien" href={u('/portrait/')}>Portrait — Art &amp; Âme</a></li>
              <li><a class="lien" href={u('/mariage/')}>Mariage</a></li>
              <li><a class="lien" href={u('/a-propos/')}>À propos</a></li>
              <li><a class="lien" href={u('/journal/')}>Journal</a></li>
              <li><a class="lien" href={u('/contact/')}>Contact</a></li>
            </>
          ) : (
            <>
              <li><a class="lien" href={u('/en/portraits/')}>Portraits</a></li>
              <li><a class="lien" href={u('/en/weddings/')}>Weddings</a></li>
              <li><a class="lien" href={u('/en/about/')}>About</a></li>
              <li><a class="lien" href={u('/en/contact/')}>Contact</a></li>
            </>
          )}
        </ul>
      </div>
      <div>
        <p class="label">{fr ? 'Territoires' : 'Destinations'}</p>
        <ul>
          {/* [N-07] maillage territoires — 5 liens maximum, au-delà l'autorité se dilue */}
          {fr ? (
            <>
              <li><a class="lien" href={u('/photographe-mariage-val-de-loire/')}>Mariage en Val de Loire</a></li>
              <li><a class="lien" href={u('/photographe-mariage-paris/')}>Mariage à Paris</a></li>
              <li><a class="lien" href={u('/photographe-mariage-normandie/')}>Mariage en Normandie</a></li>
              <li><a class="lien" href={u('/photographe-mariage-corse/')}>Mariage en Corse</a></li>
              <li><a class="lien" href={u('/mariage-destination/')}>Mariage à l’étranger</a></li>
              <li><a class="lien" href={u('/en/')} hreflang="en" rel="alternate">English version</a></li>
            </>
          ) : (
            <>
              <li><a class="lien" href={u('/en/loire-valley-wedding-photographer/')}>Loire Valley weddings</a></li>
              <li><a class="lien" href={u('/en/corsica-wedding-photographer/')}>Corsica weddings</a></li>
              <li><a class="lien" href={u('/en/destination-weddings/')}>Destination weddings</a></li>
              <li><a class="lien" href={u('/en/pre-wedding-paris-loire-valley/')}>Pre-wedding sessions</a></li>
              <li><a class="lien" href={u('/')} hreflang="fr" rel="alternate">Version française</a></li>
            </>
          )}
        </ul>
      </div>
      <div>
        <p class="label">{fr ? 'Écrire' : 'Reach out'}</p>
        <ul>
          <li><a class="lien" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a class="lien" href={SITE.instagram} rel="me noopener" target="_blank">Instagram</a></li>
          <li class="adresse">{SITE.adresse.rue}, {SITE.adresse.codePostal} {SITE.adresse.ville}</li>
        </ul>
      </div>
    </div>

    <div class="basline">
      <p>© {annee} {SITE.nom} — {fr ? 'Photographe portraitiste · Gien · Val de Loire · Paris' : 'Portrait & wedding photographer · Loire Valley · Paris'}</p>
      <p class="maison">
        {fr
          ? <>Une maison&nbsp;: <a class="lien" href={SITE.studioUrl} rel="noopener">Studio NathSam</a></>
          : <>One house: <a class="lien" href={SITE.studioUrl} rel="noopener">Studio NathSam</a></>}
        &nbsp;·&nbsp;<a class="lien" href={u('/mentions-legales/')}>{fr ? 'Mentions légales' : 'Legal notice'}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .pied {
    padding-block: clamp(4rem, 10vh, 7rem) 2.5rem;
    font-size: 0.95rem;
  }

  .colonnes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 3rem 2rem;
  }

  .pied ul {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.55rem;
  }

  .pied a { opacity: 0.88; }
  .pied a:hover { opacity: 1; }

  .adresse { color: var(--pierre-claire); }

  .basline {
    margin-top: clamp(3rem, 8vh, 5rem);
    padding-top: 1.6rem;
    border-top: 1px solid rgba(244, 241, 235, 0.14);
    display: flex;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    font-family: var(--sans);
    font-weight: 300;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--pierre-claire);
  }
</style>
