---
import { u, abs, estDemo } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rideau from '../components/Rideau.astro';
import { SITE, type Locale } from '../lib/site';

interface Props {
  titre: string;
  description: string;
  lang?: Locale;
  /** chemin (sans domaine) de l'équivalent dans l'autre langue — active hreflang */
  alterne?: string;
  /** header posé sur image sombre ou fond clair */
  entete?: 'clair' | 'sombre';
  /** [T-01] nom de l'image de partage dans /partage/ (sans préfixe og- ni extension) */
  partage?: string;
  /** texte alternatif de l'image de partage */
  partageAlt?: string;
  /** [T-03] 'article' sur les pages Journal */
  typeOg?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
}
const {
  titre,
  description,
  lang = 'fr',
  alterne,
  entete = 'clair',
  partage = 'accueil',
  partageAlt = 'Photographie de Nathanaël Charpentier',
  typeOg = 'website',
  jsonLd = [],
} = Astro.props;

const chemin = Astro.url.pathname;
const canonique = abs(chemin.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/');
const urlAlterne = alterne ? abs(alterne) : null;
const urlFr = lang === 'fr' ? canonique : urlAlterne;
const urlEn = lang === 'en' ? canonique : urlAlterne;

// [T-01] og:image absolue — obligatoire sur toutes les pages
const imagePartage = abs(`/partage/og-${partage}.jpg`);

// [T-02] Entités : les IA raisonnent en entités — @id stables, Person <-> Organization liées
const personne = {
  '@type': 'Person',
  '@id': `${SITE.url}/#nathanael-charpentier`,
  name: SITE.nom,
  jobTitle: lang === 'fr' ? 'Photographe portraitiste' : 'Portrait photographer',
  url: SITE.url,
  worksFor: { '@id': `${SITE.url}/#studio-nathsam` },
  award: [...SITE.distinctions],
  memberOf: SITE.affiliations.map((a) =>
    a.role
      ? {
          '@type': 'OrganizationRole',
          roleName: a.role,
          memberOf: { '@type': 'Organization', name: a.nom },
        }
      : { '@type': 'Organization', name: a.nom }
  ),
  knowsAbout: [...SITE.savoirFaire],
  sameAs: [SITE.instagram, SITE.studioUrl],
};
const organisation = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#studio-nathsam`,
  name: SITE.studio,
  url: SITE.studioUrl,
  founder: { '@id': `${SITE.url}/#nathanael-charpentier` },
};
const entreprise = {
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#localbusiness`,
  name: `${SITE.nom} — Photographe`,
  image: imagePartage,
  url: SITE.url,
  telephone: SITE.telephone,
  email: SITE.email,
  priceRange: '€€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.adresse.rue,
    postalCode: SITE.adresse.codePostal,
    addressLocality: SITE.adresse.ville,
    addressRegion: SITE.adresse.region,
    addressCountry: SITE.adresse.pays,
  },
  areaServed: [...SITE.zone],
  founder: { '@id': `${SITE.url}/#nathanael-charpentier` },
};
const graphe = {
  '@context': 'https://schema.org',
  '@graph': [personne, organisation, entreprise, ...jsonLd],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {/* [T-04] la démo GitHub Pages ne doit jamais être indexée */}
    {estDemo && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonique} />
    {urlFr && <link rel="alternate" hreflang="fr" href={urlFr} />}
    {urlEn && <link rel="alternate" hreflang="en" href={urlEn} />}
    {urlFr && <link rel="alternate" hreflang="x-default" href={urlFr} />}
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <link
      rel="preload"
      href={u('/fonts/cormorantgaramond-300-normal-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={u('/fonts/jost-400-normal-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={u('/fonts/fonts.css')} />
    <meta name="theme-color" content="#141311" />
    {/* JS disponible : on autorise le masquage des blocs avant leur apparition.
        Sans ce marqueur, tout le contenu reste visible — garde-fou volontaire. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={typeOg} />
    <meta property="og:url" content={canonique} />
    <meta property="og:site_name" content={SITE.nom} />
    {/* [M-27] locale en_GB : cible mariage international européenne */}
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:image" content={imagePartage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={partageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titre} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagePartage} />
    <meta name="twitter:image:alt" content={partageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(graphe)} />
  </head>
  <body>
    <Rideau />
    <a class="evasion" href="#principal">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <Header lang={lang} fond={entete} alterne={alterne} chemin={chemin} />
    <main id="principal">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Apparitions au défilement, avec trois garde-fous : si l'observateur n'existe
      // pas, s'il ne se déclenche jamais (onglet non composité, bfcache…), ou en cas
      // d'erreur, tout est révélé. Le contenu ne peut pas rester invisible.
      (() => {
        const cibles = Array.from(document.querySelectorAll('.apparait'));
        const toutMontrer = () => cibles.forEach((c) => c.classList.add('visible'));

        try {
          if (!('IntersectionObserver' in window)) return toutMontrer();

          const obs = new IntersectionObserver(
            (entrees) => {
              for (const e of entrees) {
                if (e.isIntersecting) {
                  e.target.classList.add('visible');
                  obs.unobserve(e.target);
                }
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
          );
          cibles.forEach((c) => obs.observe(c));

          // Filet : si rien n'a été révélé au bout de 2 s, on affiche tout.
          setTimeout(() => {
            if (!cibles.some((c) => c.classList.contains('visible'))) toutMontrer();
          }, 2000);
        } catch {
          toutMontrer();
        }
      })();
    </script>

    <style>
      .evasion {
        position: absolute;
        left: -200vw;
        top: 0;
        z-index: 100;
        background: var(--encre);
        color: var(--ivoire);
        padding: 0.8em 1.4em;
        font-family: var(--sans);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
      }
      .evasion:focus { left: 0; }
    </style>
  </body>
</html>
