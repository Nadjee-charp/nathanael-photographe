---
// Gabarit des récits du Journal — texte d'abord, détails vérifiables (GEO)
import { u, abs } from '../lib/url';
import Base from './Base.astro';
import { SITE } from '../lib/site';

interface Props {
  titre: string;
  description: string;
  date: string; // ISO
  dateAffichee: string;
  /** [T-01] nom de l'image de partage dans /partage/ */
  partage: string;
  partageAlt: string;
}
const { titre, description, date, dateAffichee, partage, partageAlt } = Astro.props;

// [T-03] BlogPosting sur les pages Journal — og:type article géré par le layout
const article = {
  '@type': 'BlogPosting',
  headline: titre,
  description,
  datePublished: date,
  dateModified: date,
  inLanguage: 'fr-FR',
  image: abs(`/partage/og-${partage}.jpg`),
  author: { '@id': `${SITE.url}/#nathanael-charpentier` },
  publisher: { '@id': `${SITE.url}/#nathanael-charpentier` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': abs(Astro.url.pathname) },
};
---

<Base
  titre={`${titre} · Journal — Nathanaël Charpentier`}
  description={description}
  lang="fr"
  entete="clair"
  typeOg="article"
  partage={partage}
  partageAlt={partageAlt}
  jsonLd={[article]}
>
  <article class="section entame">
    <div class="contenu mesure">
      <p class="label"><a class="lien" href={u('/journal/')}>Journal</a> — <time datetime={date}>{dateAffichee}</time></p>
      <h1>{titre}</h1>
      <div class="corps">
        <slot />
      </div>
      <p class="signature">— {SITE.nom}</p>
    </div>
  </article>
</Base>

<style>
  .entame { padding-top: clamp(7rem, 16vh, 11rem); }

  h1 { margin: 0.6rem 0 2.8rem; max-width: 16ch; }

  .corps {
    display: grid;
    gap: 1.7rem;
  }
  .corps :global(p) { max-width: var(--mesure); }
  .corps :global(img) { margin-block: 1.5rem; }

  .signature {
    margin-top: 3rem;
    font-style: italic;
    color: var(--pierre);
  }
</style>
